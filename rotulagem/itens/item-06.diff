+
+export async function getAvailability(query: AvailabilityInput): Promise<{ data: AvailableSlot[] }> {
+  const room = await repository.findRoomById(query.roomId);
+  if (!room) {
+    throw notFound('Room');
+  }
+
+  const from = parseInstant(query.from);
+  const to = parseInstant(query.to);
+  if (!isBefore(from, to)) {
+    throw validationFailed('"from" must be before "to"', { from: query.from, to: query.to });
+  }
+
+  const durationMs = query.durationMinutes * MINUTE_IN_MS;
+  const bookings = await repository.listActiveInRange(query.roomId, from, to);
+
+  const slots: AvailableSlot[] = [];
+  const addSlotsInWindow = (windowStart: Date, windowEnd: Date): void => {
+    let slotStart = windowStart.getTime();
+    const windowEndMs = windowEnd.getTime();
+    while (slots.length < MAX_AVAILABILITY_SLOTS && slotStart + durationMs <= windowEndMs) {
+      const slotEndMs = slotStart + durationMs;
+      slots.push({ startsAt: new Date(slotStart), endsAt: new Date(slotEndMs) });
+      slotStart = slotEndMs;
+    }
+  };
+
+  let cursor = from;
+  for (const booking of bookings) {
+    if (slots.length >= MAX_AVAILABILITY_SLOTS) break;
+    if (isBefore(cursor, booking.startsAt)) {
+      addSlotsInWindow(cursor, booking.startsAt);
+    }
+    if (isBefore(cursor, booking.endsAt)) {
+      cursor = booking.endsAt;
+    }
+  }
+  if (slots.length < MAX_AVAILABILITY_SLOTS && isBefore(cursor, to)) {
+    addSlotsInWindow(cursor, to);
+  }
+
+  return { data: slots };
+}
