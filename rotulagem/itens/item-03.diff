+export async function getAvailability(query: AvailabilityQueryInput): Promise<AvailabilityResult> {
+  await assertRoomExists(query.roomId);
+
+  const from = parseInstant(query.from);
+  const to = parseInstant(query.to);
+  if (!isBefore(from, to)) {
+    throw validationFailed('to must be after from');
+  }
+
+  const minDuration = query.duration ?? MIN_DURATION_MINUTES;
+  if (minDuration < MIN_DURATION_MINUTES || minDuration > MAX_DURATION_MINUTES) {
+    throw validationFailed(
+      `duration must be between ${MIN_DURATION_MINUTES} and ${MAX_DURATION_MINUTES} minutes`,
+    );
+  }
+
+  const windowStart = isBefore(from, new Date()) ? new Date() : from;
+  const bookings = await repository.listActiveBetween(query.roomId, windowStart, to);
+
+  const slots: { startsAt: Date; endsAt: Date }[] = [];
+  let cursor = windowStart;
+  for (const booking of bookings) {
+    if (isBefore(cursor, booking.startsAt) && durationMinutes(cursor, booking.startsAt) >= minDuration) {
+      slots.push({ startsAt: cursor, endsAt: booking.startsAt });
+    }
+    if (isBefore(cursor, booking.endsAt)) {
+      cursor = booking.endsAt;
+    }
+  }
+  if (isBefore(cursor, to) && durationMinutes(cursor, to) >= minDuration) {
+    slots.push({ startsAt: cursor, endsAt: to });
+  }
+
+  return { roomId: query.roomId, from: windowStart, to, slots };
+}
