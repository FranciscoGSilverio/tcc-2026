+export async function listAvailableSlots(query: AvailabilityInput): Promise<Availability> {
+  const from = parseInstant(query.from);
+  const to = parseInstant(query.to);
+  if (!isBefore(from, to)) {
+    throw validationFailed('Availability window must end after it starts');
+  }
+  await assertRoomExists(query.roomId);
+
+  // A booking never starts in the past, so a slot that has already begun is of
+  // no use to whoever is asking: the window effectively starts at the later of
+  // the requested start and now, and the answer reports that effective window.
+  const now = new Date();
+  const start = isBefore(from, now) ? now : from;
+
+  const bookings = await repository.listActiveBetween(query.roomId, from, to);
+  const slots: Slot[] = [];
+  let cursor = start;
+  for (const booking of bookings) {
+    if (isBefore(cursor, booking.startsAt)) {
+      slots.push({ startsAt: cursor, endsAt: booking.startsAt });
+    }
+    if (isBefore(cursor, booking.endsAt)) {
+      cursor = booking.endsAt;
+    }
+  }
+  if (isBefore(cursor, to)) {
+    slots.push({ startsAt: cursor, endsAt: to });
+  }
+
+  const minimum = query.durationMinutes;
+  return {
+    roomId: query.roomId,
+    from: start,
+    to,
+    slots:
+      minimum === undefined
+        ? slots
+        : slots.filter(
+            (slot) => slot.endsAt.getTime() - slot.startsAt.getTime() >= minimum * MINUTE_IN_MS,
+          ),
+  };
+}
