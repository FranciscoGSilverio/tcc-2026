+
+export async function getAvailability(query: AvailabilityInput): Promise<Availability> {
+  const from = parseInstant(query.from);
+  const to = parseInstant(query.to);
+  if (!isBefore(from, to)) {
+    throw validationFailed('to must be after from');
+  }
+
+  await getRoom(query.roomId);
+
+  const busy = await repository.findActiveInRange(query.roomId, from, to);
+
+  const freeSlots: Array<{ startsAt: Date; endsAt: Date }> = [];
+  let cursor = from;
+  for (const booking of busy) {
+    const busyStart = isBefore(booking.startsAt, from) ? from : booking.startsAt;
+    const busyEnd = isBefore(to, booking.endsAt) ? to : booking.endsAt;
+    if (isBefore(cursor, busyStart)) {
+      freeSlots.push({ startsAt: cursor, endsAt: busyStart });
+    }
+    if (isBefore(cursor, busyEnd)) {
+      cursor = busyEnd;
+    }
+  }
+  if (isBefore(cursor, to)) {
+    freeSlots.push({ startsAt: cursor, endsAt: to });
+  }
+
+  return { roomId: query.roomId, from, to, freeSlots };
+}
