 }
+
+export async function getAvailability(query: AvailabilityInput): Promise<AvailabilityResult> {
+  const from = parseInstant(query.from);
+  const to = parseInstant(query.to);
+  if (!isBefore(from, to)) {
+    throw validationFailed('"from" must be before "to"', { from: query.from, to: query.to });
+  }
+
+  const durationMs = query.duration * MINUTE_IN_MS;
+  const bookings = await repository.listActiveBetween(query.roomId, from, to);
+
+  const slots: Array<{ startsAt: Date; endsAt: Date }> = [];
+  let cursor = from;
+  for (const booking of bookings) {
+    if (booking.startsAt.getTime() - cursor.getTime() >= durationMs) {
+      slots.push({ startsAt: cursor, endsAt: booking.startsAt });
+    }
+    if (booking.endsAt.getTime() > cursor.getTime()) {
+      cursor = booking.endsAt;
+    }
+  }
+  if (to.getTime() - cursor.getTime() >= durationMs) {
+    slots.push({ startsAt: cursor, endsAt: to });
+  }
+
+  return { roomId: query.roomId, from, to, durationMinutes: query.duration, slots };
+}
+
+export async function createBookingsBatch(input: BatchCreateBookingsInput): Promise<Booking[]> {
+  const items = input.bookings.map((booking) => ({
+    roomId: booking.roomId,
+    userId: booking.userId,
+    title: booking.title,
+    startsAt: parseInstant(booking.startsAt),
+    endsAt: parseInstant(booking.endsAt),
+  }));
+
+  const result = await repository.createBatch(items);
+  if ('conflicts' in result) {
+    throw bookingBatchConflict(result.conflicts);
+  }
+  return result.created;
+}
