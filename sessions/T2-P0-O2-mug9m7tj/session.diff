+export interface BatchConflict {
+  index: number;
+  conflictingBookingId?: string;
+  conflictingBatchIndex?: number;
+}
+
 export function create(data: BookingData): Promise<Booking> {
   return prisma.booking.create({ data });
 }
 
-export function findConflictAtStart(roomId: string, startsAt: Date): Promise<Booking | null> {
+export function findOverlapping(
+  roomId: string,
+  startsAt: Date,
+  endsAt: Date,
+  excludeId?: string,
+): Promise<Booking | null> {
   return prisma.booking.findFirst({
     where: {
       roomId,
       status: BOOKING_ACTIVE,
-      startsAt: { lte: startsAt },
+      startsAt: { lt: endsAt },
       endsAt: { gt: startsAt },
+      ...(excludeId ? { id: { not: excludeId } } : {}),
+    },
+  });
+}
+
+export function listActiveBetween(roomId: string, from: Date, to: Date): Promise<Booking[]> {
+  return prisma.booking.findMany({
+    where: {
+      roomId,
+      status: BOOKING_ACTIVE,
+      startsAt: { lt: to },
+      endsAt: { gt: from },
     },
+    orderBy: { startsAt: 'asc' },
+  });
+}
+
+export async function createBatch(
+  items: BookingData[],
+): Promise<{ created: Booking[] } | { conflicts: BatchConflict[] }> {
+  return prisma.$transaction(async (tx) => {
+    const conflicts: BatchConflict[] = [];
+    const accepted: Array<{ index: number } & BookingData> = [];
+
+    for (const [index, item] of items.entries()) {
+      const batchConflict = accepted.find(
+        (other) =>
+          other.roomId === item.roomId &&
+          other.startsAt < item.endsAt &&
+          other.endsAt > item.startsAt,
+      );
+      if (batchConflict) {
+        conflicts.push({ index, conflictingBatchIndex: batchConflict.index });
+        continue;
+      }
+
+      const dbConflict = await tx.booking.findFirst({
+        where: {
+          roomId: item.roomId,
+          status: BOOKING_ACTIVE,
+          startsAt: { lt: item.endsAt },
+          endsAt: { gt: item.startsAt },
+        },
+      });
+      if (dbConflict) {
+        conflicts.push({ index, conflictingBookingId: dbConflict.id });
+        continue;
+      }
+
+      accepted.push({ index, ...item });
+    }
+
+    if (conflicts.length > 0) {
+      return { conflicts };
+    }
+
+    const created: Booking[] = [];
+    for (const item of items) {
+      created.push(await tx.booking.create({ data: item }));
+    }
+    return { created };
   });
 }
 
