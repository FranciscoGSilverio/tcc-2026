+function validateBookingDomainRules(startsAt: Date, endsAt: Date): void {
+  const now = new Date();
+
+  if (!isBefore(startsAt, endsAt)) {
+    throw validationFailed('Booking end time must be after start time');
+  }
+
+  if (!isBefore(now, startsAt)) {
+    throw validationFailed('Booking start time must be in the future');
+  }
+
+  const minutes = durationMinutes(startsAt, endsAt);
+  const minMinutes = 30;
+  const maxMinutes = 480; // 8 hours
+
+  if (minutes < minMinutes) {
+    throw validationFailed('Booking duration must be at least 30 minutes');
+  }
+
+  if (minutes > maxMinutes) {
+    throw validationFailed('Booking duration must not exceed 8 hours');
+  }
