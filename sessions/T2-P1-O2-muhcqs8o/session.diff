+
+export async function listAvailability(query: AvailabilityInput): Promise<AvailabilityResult> {
+  const from = parseInstant(query.from);
+  const to = parseInstant(query.to);
+  if (!isBefore(from, to)) {
+    throw validationFailed('"to" must be after "from"', { from: query.from, to: query.to });
+  }
+  await assertRoomExists(query.roomId);
+
+  const minDuration =
+    query.minDurationMinutes !== undefined
+      ? Math.max(query.minDurationMinutes, MIN_DURATION_MINUTES)
+      : MIN_DURATION_MINUTES;
+
+  const bookings = await repository.listActiveInRange(query.roomId, from, to);
+
+  const slots: AvailabilitySlot[] = [];
+  let cursor = from;
+  for (const booking of bookings) {
+    const bookingStart = isBefore(booking.startsAt, from) ? from : booking.startsAt;
+    const bookingEnd = isBefore(to, booking.endsAt) ? to : booking.endsAt;
+    if (isBefore(cursor, bookingStart)) {
+      slots.push({ startsAt: cursor, endsAt: bookingStart });
+    }
+    if (isBefore(cursor, bookingEnd)) {
+      cursor = bookingEnd;
+    }
+  }
+  if (isBefore(cursor, to)) {
+    slots.push({ startsAt: cursor, endsAt: to });
+  }
+
+  return {
+    roomId: query.roomId,
+    slots: slots.filter((slot) => durationMinutes(slot.startsAt, slot.endsAt) >= minDuration),
+  };
+}
