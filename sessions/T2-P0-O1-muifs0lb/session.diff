+import { createTestApp, resetDb } from './helpers/app.js';
+
+/** A fixed instant keeps the pure assertions independent of the clock. */
+function at(hour: number): Date {
+  return new Date(Date.UTC(2030, 0, 1, 0, 0, 0) + hour * 3_600_000);
+}
+
+function interval(startHour: number, endHour: number): Interval {
+  return { startsAt: at(startHour), endsAt: at(endHour) };
+}
+
+function asHours(intervals: Interval[]): [number, number][] {
+  const base = at(0).getTime();
+  return intervals.map((entry) => [
+    (entry.startsAt.getTime() - base) / 3_600_000,
+    (entry.endsAt.getTime() - base) / 3_600_000,
+  ]);
+}
+
+describe('mergeIntervals', () => {
+  it('keeps disjoint intervals apart', () => {
+    expect(asHours(mergeIntervals([interval(9, 10), interval(12, 13)]))).toEqual([
+      [9, 10],
+      [12, 13],
+    ]);
+  });
+
+  it('merges overlapping intervals', () => {
+    expect(asHours(mergeIntervals([interval(9, 11), interval(10, 12)]))).toEqual([[9, 12]]);
+  });
+
+  it('merges intervals that only touch', () => {
+    expect(asHours(mergeIntervals([interval(9, 10), interval(10, 11)]))).toEqual([[9, 11]]);
+  });
+
+  it('absorbs an interval contained in another', () => {
+    expect(asHours(mergeIntervals([interval(9, 14), interval(10, 11)]))).toEqual([[9, 14]]);
+  });
+
+  it('sorts before merging', () => {
+    expect(asHours(mergeIntervals([interval(12, 13), interval(9, 10)]))).toEqual([
+      [9, 10],
+      [12, 13],
+    ]);
+  });
+
+  it('drops empty and inverted intervals', () => {
+    expect(mergeIntervals([interval(9, 9), interval(11, 10)])).toEqual([]);
+  });
+
+  it('does not mutate the input array', () => {
+    const input = [interval(12, 13), interval(9, 10)];
+    mergeIntervals(input);
+    expect(asHours(input)).toEqual([
+      [12, 13],
+      [9, 10],
+    ]);
+  });
+});
+
+describe('freeSlots', () => {
+  it('returns the whole window when nothing is busy', () => {
+    expect(asHours(freeSlots([], interval(9, 17)))).toEqual([[9, 17]]);
+  });
+
+  it('splits the window around a busy interval', () => {
+    expect(asHours(freeSlots([interval(12, 13)], interval(9, 17)))).toEqual([
+      [9, 12],
+      [13, 17],
+    ]);
+  });
+
+  it('returns nothing when the window is fully booked', () => {
+    expect(freeSlots([interval(8, 18)], interval(9, 17))).toEqual([]);
+  });
+
+  it('clips busy intervals to the window', () => {
+    expect(asHours(freeSlots([interval(8, 10), interval(16, 20)], interval(9, 17)))).toEqual([
+      [10, 16],
+    ]);
+  });
+
+  it('ignores busy intervals that fall outside the window', () => {
+    expect(asHours(freeSlots([interval(1, 2), interval(20, 22)], interval(9, 17)))).toEqual([
+      [9, 17],
+    ]);
+  });
+
+  it('never emits a zero length slot between back to back bookings', () => {
+    expect(asHours(freeSlots([interval(9, 12), interval(12, 17)], interval(9, 17)))).toEqual([]);
+  });
+
+  it('keeps only slots that fit the requested duration', () => {
+    const busy = [interval(10, 11), interval(12, 17)];
+    expect(asHours(freeSlots(busy, interval(9, 17), 90 * MINUTE_IN_MS))).toEqual([]);
+    expect(asHours(freeSlots(busy, interval(9, 17), 60 * MINUTE_IN_MS))).toEqual([
+      [9, 10],
+      [11, 12],
+    ]);
+  });
+
+  it('reports the length of each slot in minutes', () => {
+    expect(freeSlots([interval(12, 13)], interval(9, 17))[0]?.durationMinutes).toBe(180);
