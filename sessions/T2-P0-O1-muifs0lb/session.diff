+    from: window.startsAt,
+    to: window.endsAt,
+    durationMinutes: query.durationMinutes ?? null,
+    slots: freeSlots(busy, window, (query.durationMinutes ?? 0) * MINUTE_IN_MS).slice(0, limit),
+  };
