+  return failures.some((failure) => failure.code === 'BOOKING_CONFLICT')
+    ? new AppError('BOOKING_CONFLICT', 409, message, { failures: ordered })
+    : new AppError('VALIDATION_ERROR', 400, message, { failures: ordered });
