+import {
+  durationMinutes,
+  earliest,
+  isBefore,
+  latest,
+  type Interval,
+} from '../../shared/time.js';
+
+export interface Slot extends Interval {
+  durationMinutes: number;
+}
+
+/**
+ * Collapses busy intervals into a minimal, ordered set. Empty and inverted
+ * intervals are dropped, and intervals that touch or overlap become one.
+ *
+ * Bookings created through this API can no longer overlap, but rows written
+ * before that rule existed still can, and a stale overlap would otherwise
+ * punch a phantom gap into the free slots below.
+ */
+export function mergeIntervals(intervals: Interval[]): Interval[] {
+  const sorted = intervals
+    .filter((interval) => isBefore(interval.startsAt, interval.endsAt))
+    .sort((a, b) => a.startsAt.getTime() - b.startsAt.getTime());
+
+  const merged: Interval[] = [];
+  for (const interval of sorted) {
+    const last = merged[merged.length - 1];
+    if (last && interval.startsAt.getTime() <= last.endsAt.getTime()) {
+      if (isBefore(last.endsAt, interval.endsAt)) {
+        merged[merged.length - 1] = { startsAt: last.startsAt, endsAt: interval.endsAt };
+      }
+      continue;
+    }
+    merged.push({ startsAt: interval.startsAt, endsAt: interval.endsAt });
+  }
+  return merged;
+}
+
+/**
+ * Returns the gaps left between `busy` inside `window`, clipped to the window
+ * and keeping only gaps of at least `minDurationMs`.
+ */
+export function freeSlots(busy: Interval[], window: Interval, minDurationMs = 0): Slot[] {
+  const slots: Slot[] = [];
+  // A gap of zero length is an instant, not a slot, so never emit one.
+  const minimum = Math.max(minDurationMs, 1);
+  let cursor = window.startsAt;
+
+  const append = (startsAt: Date, endsAt: Date): void => {
+    if (endsAt.getTime() - startsAt.getTime() < minimum) return;
+    slots.push({ startsAt, endsAt, durationMinutes: durationMinutes(startsAt, endsAt) });
+  };
+
+  for (const interval of mergeIntervals(busy)) {
+    const startsAt = latest(interval.startsAt, window.startsAt);
+    const endsAt = earliest(interval.endsAt, window.endsAt);
+    if (!isBefore(startsAt, endsAt)) continue;
+    if (isBefore(cursor, startsAt)) append(cursor, startsAt);
+    if (isBefore(cursor, endsAt)) cursor = endsAt;
+  }
+  append(cursor, window.endsAt);
+
+  return slots;
+}
+
+/**
+ * Picks up to `max` concrete intervals of exactly `durationMs`, one anchored at
+ * the start of each free gap, so each suggestion can be re-sent as-is.
+ */
+export function suggestSlots(
+  busy: Interval[],
+  window: Interval,
+  durationMs: number,
+  max: number,
+): Interval[] {
+  const suggestions: Interval[] = [];
+  for (const slot of freeSlots(busy, window, durationMs)) {
+    if (suggestions.length >= max) break;
+    suggestions.push({
+      startsAt: slot.startsAt,
+      endsAt: new Date(slot.startsAt.getTime() + durationMs),
+    });
+  }
+  return suggestions;
+}
