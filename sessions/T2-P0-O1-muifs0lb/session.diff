+
+  function inHours(hours: number): string {
+    return new Date(base + hours * HOUR).toISOString();
+  }
+
+  function entry(startHours: number, endHours: number, title: string, room = roomId): Entry {
+    return { roomId: room, userId, title, startsAt: inHours(startHours), endsAt: inHours(endHours) };
+  }
+
+  function batch(bookings: Entry[]) {
+    return app.inject({ method: 'POST', url: '/bookings/batch', payload: { bookings } });
+  }
+
+  async function storedBookings(): Promise<number> {
+    const response = await app.inject({ method: 'GET', url: '/bookings' });
+    return response.json().pagination.total;
+  }
+
+  it('creates every booking of the request', async () => {
+    const response = await batch([entry(24, 25, 'A'), entry(26, 27, 'B'), entry(28, 29, 'C')]);
+    expect(response.statusCode).toBe(201);
+    expect(response.json().data).toHaveLength(3);
+    expect(response.json().data.map((booking: { title: string }) => booking.title)).toEqual([
+      'A',
+      'B',
+      'C',
+    ]);
+  });
+
+  it('persists everything it reports as created', async () => {
+    await batch([entry(24, 25, 'A'), entry(26, 27, 'B')]);
+    expect(await storedBookings()).toBe(2);
+  });
+
+  it('accepts back to back bookings in the same request', async () => {
+    const response = await batch([entry(24, 25, 'A'), entry(25, 26, 'B')]);
+    expect(response.statusCode).toBe(201);
+  });
+
+  it('accepts overlapping bookings when the rooms differ', async () => {
+    const response = await batch([entry(24, 25, 'A'), entry(24, 25, 'B', otherRoomId)]);
