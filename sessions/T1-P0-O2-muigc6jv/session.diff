+
+  it('rejects a booking that starts before and overlaps into an active booking', async () => {
+    await book(24, 25);
+    const response = await book(23.5, 24.5, 'Overlap from before');
+    expect(response.statusCode).toBe(409);
+    expect(response.json().error.code).toBe('BOOKING_CONFLICT');
+  });
+
+  it('rejects a booking that fully contains an active booking', async () => {
+    await book(24.1, 24.9);
+    const response = await book(24, 25, 'Contains');
+    expect(response.statusCode).toBe(409);
+  });
+
+  it('rejects a booking whose endsAt is before startsAt', async () => {
+    const response = await book(25, 24);
+    expect(response.statusCode).toBe(400);
+    expect(response.json().error.code).toBe('VALIDATION_ERROR');
+  });
+
+  it('rejects a booking whose endsAt equals startsAt', async () => {
+    const response = await book(24, 24);
+    expect(response.statusCode).toBe(400);
+  });
+
+  it('rejects moving a booking onto a time slot that conflicts with another booking', async () => {
+    await book(24, 25);
+    const second = await book(30, 31, 'Retro');
+    const response = await app.inject({
+      method: 'PATCH',
+      url: `/bookings/${second.json().id}`,
+      payload: { startsAt: inHours(24.5), endsAt: inHours(25.5) },
+    });
+    expect(response.statusCode).toBe(409);
+    expect(response.json().error.code).toBe('BOOKING_CONFLICT');
+  });
+
+  it('rejects updating a booking so endsAt is before startsAt', async () => {
+    const created = await book(24, 25);
+    const response = await app.inject({
+      method: 'PATCH',
+      url: `/bookings/${created.json().id}`,
+      payload: { startsAt: inHours(26) },
+    });
+    expect(response.statusCode).toBe(400);
+  });
+
+  it('allows updating a booking to a non-conflicting slot', async () => {
+    const created = await book(24, 25);
+    const response = await app.inject({
+      method: 'PATCH',
+      url: `/bookings/${created.json().id}`,
+      payload: { startsAt: inHours(40), endsAt: inHours(41) },
