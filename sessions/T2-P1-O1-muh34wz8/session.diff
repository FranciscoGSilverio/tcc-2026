 }
+
+export async function getRoomAvailability(
+  query: AvailabilityInput,
+): Promise<{ data: AvailabilitySlotOutput[] }> {
+  await getRoom(query.roomId);
+
+  const from = parseInstant(query.from);
+  const to = parseInstant(query.to);
+  if (!isBefore(from, to)) {
+    throw validationFailed('"to" must be after "from"');
+  }
+
+  const durationMs = (query.duration ?? MIN_BOOKING_MINUTES) * MINUTE_IN_MS;
+  const bookings = await repository.findActiveByRoomInRange(query.roomId, from, to);
+
+  const data: AvailabilitySlotOutput[] = [];
+  let cursor = from;
+  for (const booking of bookings) {
+    if (booking.startsAt.getTime() - cursor.getTime() >= durationMs) {
+      data.push({ startsAt: cursor, endsAt: booking.startsAt });
+    }
+    if (booking.endsAt.getTime() > cursor.getTime()) {
+      cursor = booking.endsAt;
+    }
+  }
+  if (to.getTime() - cursor.getTime() >= durationMs) {
+    data.push({ startsAt: cursor, endsAt: to });
+  }
+
+  return { data };
+}
