     expect(response.json().error.details.conflictingBookingId).toBe(first.json().id);
   });
+
+  describe('room availability', () => {
+    async function availability(query: string) {
+      return app.inject({ method: 'GET', url: `/bookings/availability?${query}` });
+    }
+
+    it('returns the whole window as free when there are no bookings', async () => {
+      const from = inHours(24);
+      const to = inHours(26);
+      const response = await availability(`roomId=${roomId}&from=${from}&to=${to}`);
+      expect(response.statusCode).toBe(200);
+      const { data } = response.json();
+      expect(data).toHaveLength(1);
+      expect(new Date(data[0].startsAt).getTime()).toBe(new Date(from).getTime());
+      expect(new Date(data[0].endsAt).getTime()).toBe(new Date(to).getTime());
+    });
+
+    it('excludes an active booking from the free slots', async () => {
+      const from = inHours(23);
+      const bookingStart = inHours(24);
+      const bookingEnd = inHours(25);
+      const to = inHours(26);
+      await book(24, 25);
+      const response = await availability(`roomId=${roomId}&from=${from}&to=${to}`);
+      const { data } = response.json();
+      expect(data).toHaveLength(2);
+      expect(new Date(data[0].startsAt).getTime()).toBe(new Date(from).getTime());
+      expect(new Date(data[0].endsAt).getTime()).toBe(new Date(bookingStart).getTime());
+      expect(new Date(data[1].startsAt).getTime()).toBe(new Date(bookingEnd).getTime());
+      expect(new Date(data[1].endsAt).getTime()).toBe(new Date(to).getTime());
+    });
+
+    it('does not list a cancelled booking as occupying time', async () => {
+      const first = await book(24, 25);
+      await app.inject({ method: 'POST', url: `/bookings/${first.json().id}/cancel` });
+      const response = await availability(`roomId=${roomId}&from=${inHours(24)}&to=${inHours(25)}`);
+      expect(response.json().data).toHaveLength(1);
+    });
+
+    it('omits gaps shorter than the requested (or default minimum) duration', async () => {
+      await book(24, 24.75);
+      await book(25, 26);
+      const response = await availability(`roomId=${roomId}&from=${inHours(24)}&to=${inHours(26)}`);
+      expect(response.json().data).toEqual([]);
+    });
+
+    it('honours a custom duration filter', async () => {
+      await book(24, 25);
+      const response = await availability(
+        `roomId=${roomId}&from=${inHours(25)}&to=${inHours(25.75)}&duration=60`,
+      );
+      expect(response.json().data).toEqual([]);
+    });
+
+    it('answers 404 when the room does not exist', async () => {
