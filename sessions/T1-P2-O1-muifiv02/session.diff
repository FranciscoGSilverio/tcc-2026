+function validateBookingWindow(startsAt: Date, endsAt: Date): void {
+  if (!isBefore(startsAt, endsAt)) {
+    throw validationFailed('endsAt must be after startsAt', { startsAt, endsAt });
+  }
+  const duration = durationMinutes(startsAt, endsAt);
+  if (duration < MIN_DURATION_MINUTES || duration > MAX_DURATION_MINUTES) {
+    throw validationFailed('Booking duration must be between 30 minutes and 8 hours', { duration });
+  }
+  if (isBefore(startsAt, new Date())) {
+    throw validationFailed('startsAt cannot be in the past', { startsAt });
+  }
