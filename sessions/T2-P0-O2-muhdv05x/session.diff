+
+export interface Availability {
+  roomId: string;
+  from: Date;
+  to: Date;
+  freeSlots: { startsAt: Date; endsAt: Date }[];
+}
+
+export async function getAvailability(query: AvailabilityInput): Promise<Availability> {
+  const from = parseInstant(query.from);
+  const to = parseInstant(query.to);
+  if (!isBefore(from, to)) {
+    throw validationFailed('`to` must be after `from`', { from: query.from, to: query.to });
+  }
+
+  const busy = await repository.listActiveInRange(query.roomId, from, to);
+
+  const freeSlots: { startsAt: Date; endsAt: Date }[] = [];
+  let cursor = from;
+  for (const booking of busy) {
+    const busyStart = isBefore(booking.startsAt, from) ? from : booking.startsAt;
+    if (isBefore(cursor, busyStart)) {
+      freeSlots.push({ startsAt: cursor, endsAt: busyStart });
+    }
+    if (isBefore(cursor, booking.endsAt)) {
+      cursor = isBefore(to, booking.endsAt) ? to : booking.endsAt;
+    }
+  }
+  if (isBefore(cursor, to)) {
+    freeSlots.push({ startsAt: cursor, endsAt: to });
+  }
+
+  return { roomId: query.roomId, from, to, freeSlots };
+}
+
+export async function createBookingsBatch(
+  inputs: BatchCreateBookingsInput,
+): Promise<BatchBookingResultItem[]> {
+  const results: BatchBookingResultItem[] = [];
+  for (const input of inputs) {
+    try {
+      const booking = await createBooking(input);
+      results.push({ status: 'created', booking });
+    } catch (error) {
+      if (error instanceof AppError) {
+        results.push({
+          status: 'failed',
+          error: { code: error.code, message: error.message, details: error.details },
+        });
+        continue;
+      }
+      throw error;
+    }
+  }
+  return results;
+}
