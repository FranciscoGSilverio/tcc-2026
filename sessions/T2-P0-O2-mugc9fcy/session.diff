+interface Slot {
+  startsAt: Date;
+  endsAt: Date;
+}
+
+function computeFreeSlots(
+  bookings: Array<{ startsAt: Date; endsAt: Date }>,
+  from: Date,
+  to: Date,
+  durationMinutes: number,
+): Slot[] {
+  const minDurationMs = durationMinutes * MINUTE_IN_MS;
+  const slots: Slot[] = [];
+  let cursor = from;
+
+  for (const booking of bookings) {
+    const gapEnd = booking.startsAt > cursor ? booking.startsAt : cursor;
+    if (gapEnd.getTime() - cursor.getTime() >= minDurationMs) {
+      slots.push({ startsAt: cursor, endsAt: gapEnd });
+    }
+    if (booking.endsAt > cursor) {
+      cursor = booking.endsAt;
+    }
+  }
+
+  if (to.getTime() - cursor.getTime() >= minDurationMs) {
+    slots.push({ startsAt: cursor, endsAt: to });
+  }
+
+  return slots;
+}
+
