@@ -180,4 +180,128 @@ describe('bookings', () => {
     const response = await book(24.5, 25.5, 'Overlap');
     expect(response.json().error.details.conflictingBookingId).toBe(first.json().id);
   });
+
+  it('rejects a booking that fully contains an active booking', async () => {
+    await book(24.25, 24.75);
+    const response = await book(24, 25, 'Engulfing');
+    expect(response.statusCode).toBe(409);
+    expect(response.json().error.code).toBe('BOOKING_CONFLICT');
+  });
+
+  it('suggests free slots when a conflict happens', async () => {
+    const first = await book(24, 25);
+    const response = await book(24.5, 25.5, 'Overlap');
+    const suggestions = response.json().error.details.suggestions;
+    expect(Array.isArray(suggestions)).toBe(true);
+    expect(suggestions.length).toBeGreaterThan(0);
+
+    const [slot] = suggestions;
+    const followUp = await app.inject({
+      method: 'POST',
+      url: '/bookings',
+      payload: { roomId, userId, title: 'From suggestion', startsAt: slot.startsAt, endsAt: slot.endsAt },
+    });
+    expect(followUp.statusCode).toBe(201);
+    expect(first.statusCode).toBe(201);
+  });
+
+  it('rejects moving a booking on top of another via PATCH', async () => {
+    await book(24, 25);
+    const second = await book(26, 27, 'Movable');
+    const response = await app.inject({
+      method: 'PATCH',
+      url: `/bookings/${second.json().id}`,
+      payload: { startsAt: inHours(24.5), endsAt: inHours(25.5) },
+    });
+    expect(response.statusCode).toBe(409);
+  });
+
+  it('allows patching a booking to a slot it already occupies', async () => {
+    const created = await book(24, 25);
+    const response = await app.inject({
+      method: 'PATCH',
+      url: `/bookings/${created.json().id}`,
+      payload: { title: 'Same slot, new title' },
+    });
+    expect(response.statusCode).toBe(200);
+  });
+
+  describe('availability', () => {
+    // Uses a base timestamp fixed per test (instead of the shared `inHours` helper, which
+    // resolves Date.now() on every call) so slot timestamps compare exactly without ms drift.
+    function at(base: number, hours: number): string {
+      return new Date(base + hours * HOUR).toISOString();
+    }
+
+    async function createBooking(base: number, startHours: number, endHours: number, title = 'Sync') {
+      return app.inject({
+        method: 'POST',
+        url: '/bookings',
+        payload: { roomId, userId, title, startsAt: at(base, startHours), endsAt: at(base, endHours) },
+      });
+    }
+
+    async function availability(
+      base: number,
+      fromHours: number,
+      toHours: number,
+      durationMinutes?: number,
+    ) {
+      const params = new URLSearchParams({
+        roomId,
+        from: at(base, fromHours),
+        to: at(base, toHours),
+      });
+      if (durationMinutes !== undefined) {
+        params.set('durationMinutes', String(durationMinutes));
+      }
+      return app.inject({ method: 'GET', url: `/bookings/availability?${params.toString()}` });
+    }
+
+    it('returns the whole window as free when there are no bookings', async () => {
+      const base = Date.now();
+      const response = await availability(base, 24, 26);
+      expect(response.statusCode).toBe(200);
+      expect(response.json().slots).toHaveLength(1);
+    });
+
+    it('returns the gaps around existing bookings', async () => {
+      const base = Date.now();
+      await createBooking(base, 24, 25);
+      const response = await availability(base, 23, 26);
+      expect(response.json().slots).toEqual([
+        { startsAt: at(base, 23), endsAt: at(base, 24) },
+        { startsAt: at(base, 25), endsAt: at(base, 26) },
+      ]);
+    });
+
+    it('does not report a gap between two adjacent bookings', async () => {
+      const base = Date.now();
+      await createBooking(base, 24, 25);
+      await createBooking(base, 25, 26, 'Adjacent');
+      const response = await availability(base, 24, 26);
+      expect(response.json().slots).toHaveLength(0);
+    });
+
+    it('filters out a window shorter than the requested duration', async () => {
+      const base = Date.now();
+      const response = await availability(base, 0, 1, 90);
+      expect(response.json().slots).toHaveLength(0);
+    });
+
+    it('answers 404 for a room that does not exist', async () => {
+      const base = Date.now();
+      const response = await app.inject({
+        method: 'GET',
+        url: `/bookings/availability?roomId=missing&from=${at(base, 0)}&to=${at(base, 1)}`,
+      });
+      expect(response.statusCode).toBe(404);
+    });
+
+    it('rejects a window where "to" is not after "from"', async () => {
+      const base = Date.now();
+      const response = await availability(base, 26, 24);
+      expect(response.statusCode).toBe(400);
+    });
+  });
 });
