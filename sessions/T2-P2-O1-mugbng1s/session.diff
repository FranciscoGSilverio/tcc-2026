+
+export async function getAvailability(input: AvailabilityInput): Promise<AvailabilityReport> {
+  const from = parseInstant(input.from);
+  const to = parseInstant(input.to);
+  if (!isBefore(from, to)) {
+    throw validationFailed('`to` must be after `from`', { from: input.from, to: input.to });
+  }
+
+  const room = await repository.findRoomById(input.roomId);
+  if (!room) {
+    throw notFound('Room');
+  }
+
+  const minDuration = input.duration ?? MIN_BOOKING_DURATION_MINUTES;
+  const bookings = await repository.listActiveOverlapping(input.roomId, from, to);
+
+  const slots: AvailabilitySlotData[] = [];
+  let cursor = from;
+  for (const booking of bookings) {
+    if (isBefore(cursor, booking.startsAt)) {
+      addSlot(slots, cursor, booking.startsAt, minDuration);
+    }
+    if (isBefore(cursor, booking.endsAt)) {
+      cursor = booking.endsAt;
+    }
+  }
+  if (isBefore(cursor, to)) {
+    addSlot(slots, cursor, to, minDuration);
+  }
+
+  return { roomId: input.roomId, from, to, slots };
+}
+
+function addSlot(slots: AvailabilitySlotData[], startsAt: Date, endsAt: Date, minDuration: number): void {
+  if (durationMinutes(startsAt, endsAt) >= minDuration) {
+    slots.push({ startsAt, endsAt });
+  }
+}
