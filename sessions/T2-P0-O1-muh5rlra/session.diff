diff --git a/tests/bookings.test.ts b/tests/bookings.test.ts
index 7b4db38..3ae8e57 100644
--- a/tests/bookings.test.ts
+++ b/tests/bookings.test.ts
@@ -180,4 +180,53 @@ describe('bookings', () => {
     const response = await book(24.5, 25.5, 'Overlap');
     expect(response.json().error.details.conflictingBookingId).toBe(first.json().id);
   });
+
+  it('rejects a booking that starts before and ends during an existing booking', async () => {
+    await book(24.5, 25.5);
+    const response = await book(24, 25, 'Overlap before');
+    expect(response.statusCode).toBe(409);
+  });
+
+  it('rejects a booking that completely contains an existing booking', async () => {
+    await book(24.5, 25.5);
+    const response = await book(24, 26, 'Contains');
+    expect(response.statusCode).toBe(409);
+  });
+
+  it('rejects updating a booking to conflict with another', async () => {
+    await book(24, 25);
+    const booking = await book(26, 27);
+    const response = await app.inject({
+      method: 'PATCH',
+      url: `/bookings/${booking.json().id}`,
+      payload: { startsAt: inHours(24.5), endsAt: inHours(25.5) },
+    });
+    expect(response.statusCode).toBe(409);
+    expect(response.json().error.code).toBe('BOOKING_CONFLICT');
+  });
+
+  it('accepts updating a booking to a free slot', async () => {
+    await book(24, 25);
+    const booking = await book(26, 27);
+    const originalStart = booking.json().startsAt;
+    const response = await app.inject({
+      method: 'PATCH',
+      url: `/bookings/${booking.json().id}`,
+      payload: { startsAt: inHours(28), endsAt: inHours(29) },
+    });
+    expect(response.statusCode).toBe(200);
+    expect(response.json().startsAt).not.toBe(originalStart);
+  });
+
+  it('accepts updating only the title without conflict checks', async () => {
+    await book(24, 25);
+    const booking = await book(26, 27);
+    const response = await app.inject({
+      method: 'PATCH',
+      url: `/bookings/${booking.json().id}`,
+      payload: { title: 'Retitled' },
+    });
+    expect(response.statusCode).toBe(200);
+    expect(response.json().title).toBe('Retitled');
+  });
 });
