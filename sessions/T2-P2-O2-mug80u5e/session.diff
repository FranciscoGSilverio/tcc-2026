+
+function freeSlots(
+  booked: Booking[],
+  from: Date,
+  to: Date,
+  minMinutes: number,
+): AvailabilitySlotData[] {
+  const slots: AvailabilitySlotData[] = [];
+  const collect = (startsAt: Date, endsAt: Date): void => {
+    if (isBefore(startsAt, endsAt) && durationMinutes(startsAt, endsAt) >= minMinutes) {
+      slots.push({ startsAt, endsAt });
+    }
+  };
+
+  let cursor = from;
+  for (const booking of booked) {
+    if (!isBefore(cursor, to)) {
+      break;
+    }
+    const occupiedFrom = latest(booking.startsAt, from);
+    if (isBefore(cursor, occupiedFrom)) {
+      collect(cursor, earliest(occupiedFrom, to));
+    }
+    cursor = latest(cursor, booking.endsAt);
+  }
+  if (isBefore(cursor, to)) {
+    collect(cursor, to);
+  }
+  return slots;
+}
