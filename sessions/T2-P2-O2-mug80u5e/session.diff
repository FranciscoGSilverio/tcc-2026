+export async function listAvailability(query: AvailabilityInput): Promise<Availability> {
+  await getRoom(query.roomId);
+
+  const from = parseInstant(query.from);
+  const to = parseInstant(query.to);
+  const requested = query.durationMinutes ?? MIN_BOOKING_MINUTES;
+
+  if (!isBefore(from, to)) {
+    throw validationFailed('Availability window must end after it starts');
+  }
+  if (durationMinutes(from, to) > MAX_AVAILABILITY_DAYS * DAY_IN_MINUTES) {
+    throw validationFailed('Availability window is too long', {
+      maxDays: MAX_AVAILABILITY_DAYS,
+    });
+  }
+  assertDurationInRange(requested, 'Requested duration is out of range');
+
+  // A booking can never start in the past, so a slot that already began is of
+  // no use to whoever is asking: the window is clipped to the present.
+  const windowStart = latest(from, new Date());
+  const booked = isBefore(windowStart, to)
+    ? await repository.findActiveOverlapping(query.roomId, windowStart, to)
+    : [];
+
+  return {
+    roomId: query.roomId,
+    from,
+    to,
+    durationMinutes: requested,
+    slots: freeSlots(booked, windowStart, to, requested),
+  };
+}
+
 export async function updateBooking(id: string, input: UpdateBookingInput): Promise<Booking> {
-  await getBooking(id);
+  const booking = await getBooking(id);
+
+  if (input.roomId !== undefined) {
+    await getRoom(input.roomId);
+  }
+  if (input.userId !== undefined) {
+    await getUser(input.userId);
+  }
+
+  const roomId = input.roomId ?? booking.roomId;
+  const startsAt = input.startsAt !== undefined ? parseInstant(input.startsAt) : booking.startsAt;
+  const endsAt = input.endsAt !== undefined ? parseInstant(input.endsAt) : booking.endsAt;
+  const movesSchedule =
+    input.roomId !== undefined || input.startsAt !== undefined || input.endsAt !== undefined;
+
+  if (movesSchedule) {
+    assertBookingWindow(startsAt, endsAt);
+    // A cancelled booking occupies no time, so moving one disputes nothing.
+    if (booking.status === BOOKING_ACTIVE) {
+      await assertConflictFree(roomId, startsAt, endsAt, id);
+    }
+  }
+
   return repository.update(id, {
     ...(input.roomId !== undefined ? { roomId: input.roomId } : {}),
     ...(input.userId !== undefined ? { userId: input.userId } : {}),
     ...(input.title !== undefined ? { title: input.title } : {}),
-    ...(input.startsAt !== undefined ? { startsAt: parseInstant(input.startsAt) } : {}),
-    ...(input.endsAt !== undefined ? { endsAt: parseInstant(input.endsAt) } : {}),
+    ...(input.startsAt !== undefined ? { startsAt } : {}),
+    ...(input.endsAt !== undefined ? { endsAt } : {}),
   });
 }
 
