diff --git a/src/shared/interval.ts b/src/shared/interval.ts
new file mode 100644
index 0000000..7cb2422
--- /dev/null
+++ b/src/shared/interval.ts
@@ -0,0 +1,91 @@
+import { MINUTE_IN_MS } from './time.js';
+
+export interface Interval {
+  startsAt: Date;
+  endsAt: Date;
+}
+
+export function lengthMs(interval: Interval): number {
+  return interval.endsAt.getTime() - interval.startsAt.getTime();
+}
+
+/**
+ * Intervals are half-open: [startsAt, endsAt). A booking that starts exactly
+ * when another ends does not overlap it.
+ */
+export function overlaps(a: Interval, b: Interval): boolean {
+  return a.startsAt.getTime() < b.endsAt.getTime() && b.startsAt.getTime() < a.endsAt.getTime();
+}
+
+/** Sorts by start and collapses overlapping or touching intervals into one. */
+export function merge(intervals: Interval[]): Interval[] {
+  const sorted = [...intervals]
+    .filter((interval) => lengthMs(interval) > 0)
+    .sort((a, b) => a.startsAt.getTime() - b.startsAt.getTime());
+
+  const merged: Interval[] = [];
+  for (const interval of sorted) {
+    const last = merged[merged.length - 1];
+    if (last && interval.startsAt.getTime() <= last.endsAt.getTime()) {
+      if (interval.endsAt.getTime() > last.endsAt.getTime()) {
+        merged[merged.length - 1] = { startsAt: last.startsAt, endsAt: interval.endsAt };
+      }
+      continue;
+    }
+    merged.push({ startsAt: interval.startsAt, endsAt: interval.endsAt });
+  }
+  return merged;
+}
+
+/**
+ * Returns the parts of `window` not covered by `busy`, in chronological
+ * order. Gaps shorter than `minLengthMs` are dropped.
+ */
+export function freeGaps(window: Interval, busy: Interval[], minLengthMs = 0): Interval[] {
+  const windowStart = window.startsAt.getTime();
+  const windowEnd = window.endsAt.getTime();
+  if (windowEnd <= windowStart) return [];
+
+  const clamped = busy
+    .map((interval) => ({
+      startsAt: new Date(Math.max(interval.startsAt.getTime(), windowStart)),
+      endsAt: new Date(Math.min(interval.endsAt.getTime(), windowEnd)),
+    }))
+    .filter((interval) => lengthMs(interval) > 0);
+
+  const gaps: Interval[] = [];
+  let cursor = windowStart;
+  for (const taken of merge(clamped)) {
+    if (cursor < taken.startsAt.getTime()) {
+      gaps.push({ startsAt: new Date(cursor), endsAt: new Date(taken.startsAt.getTime()) });
+    }
+    cursor = Math.max(cursor, taken.endsAt.getTime());
+  }
+  if (cursor < windowEnd) {
+    gaps.push({ startsAt: new Date(cursor), endsAt: new Date(windowEnd) });
+  }
+
+  const floor = Math.max(minLengthMs, 1);
+  return gaps.filter((gap) => lengthMs(gap) >= floor);
+}
+
+/**
+ * Turns free gaps into concrete bookable slots of exactly `lengthMs`, anchored
+ * at the start of each gap. Used to answer "when can I put this meeting?".
+ */
+export function slotsOfLength(gaps: Interval[], slotLengthMs: number, max: number): Interval[] {
+  const slots: Interval[] = [];
+  for (const gap of gaps) {
+    if (slots.length >= max) break;
+    if (lengthMs(gap) < slotLengthMs) continue;
+    slots.push({
+      startsAt: gap.startsAt,
+      endsAt: new Date(gap.startsAt.getTime() + slotLengthMs),
+    });
+  }
+  return slots;
+}
+
+export function toMinutes(ms: number): number {
+  return Math.round(ms / MINUTE_IN_MS);
+}
