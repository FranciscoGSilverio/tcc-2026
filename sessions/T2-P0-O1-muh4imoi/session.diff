+import type { Booking, Room } from '@prisma/client';
+import { prisma } from '../../db/client.js';
+import { notFound, validationFailed } from '../../shared/errors.js';
+import { freeGaps, lengthMs, toMinutes, type Interval } from '../../shared/interval.js';
+import { normalizeLimit, normalizeOffset } from '../../shared/pagination.js';
+import { MINUTE_IN_MS, parseInstant } from '../../shared/time.js';
+import * as bookingRepository from '../bookings/repository.js';
+import * as roomRepository from '../rooms/repository.js';
+import {
+  DEFAULT_WINDOW_MS,
+  MAX_SLOTS_PER_ROOM,
+  MAX_WINDOW_MS,
+  type AvailabilityInput,
+  type SearchAvailabilityInput,
+} from './schema.js';
+
+export interface Slot {
+  startsAt: Date;
+  endsAt: Date;
+  durationMinutes: number;
+}
+
+export interface RoomAvailability {
+  roomId: string;
+  from: Date;
+  to: Date;
+  durationMinutes: number | null;
+  slots: Slot[];
+  busy: { bookingId: string; startsAt: Date; endsAt: Date }[];
+}
+
+export interface AvailabilitySearch {
+  from: Date;
+  to: Date;
+  durationMinutes: number | null;
+  data: { room: Room; slots: Slot[] }[];
+  pagination: { total: number; limit: number; offset: number };
+}
+
+interface ResolvedQuery {
+  window: Interval;
+  durationMinutes: number | null;
+  minLengthMs: number;
+}
+
+/**
+ * Applies the defaults and the guard rails: the window starts now unless told
+ * otherwise, runs for a week, and may never exceed MAX_WINDOW_MS.
+ */
+function resolveQuery(query: AvailabilityInput, now = new Date()): ResolvedQuery {
+  const startsAt = query.from ? parseInstant(query.from) : now;
+  const endsAt = query.to
+    ? parseInstant(query.to)
+    : new Date(startsAt.getTime() + DEFAULT_WINDOW_MS);
+
+  const window = { startsAt, endsAt };
+  if (lengthMs(window) <= 0) {
+    throw validationFailed('to must be after from', {
+      from: startsAt.toISOString(),
+      to: endsAt.toISOString(),
+    });
+  }
+  if (lengthMs(window) > MAX_WINDOW_MS) {
+    throw validationFailed('The availability window is too wide', {
+      maxWindowDays: MAX_WINDOW_MS / (24 * 60 * 60 * 1000),
+    });
+  }
+
+  const durationMinutes = query.durationMinutes ?? null;
+  const minLengthMs = durationMinutes === null ? 0 : durationMinutes * MINUTE_IN_MS;
+  if (minLengthMs > lengthMs(window)) {
+    // Nothing can fit; say so through an empty slot list rather than an error.
+    return { window, durationMinutes, minLengthMs: Number.POSITIVE_INFINITY };
+  }
+  return { window, durationMinutes, minLengthMs };
+}
+
+function toSlot(interval: Interval): Slot {
+  return {
+    startsAt: interval.startsAt,
+    endsAt: interval.endsAt,
+    durationMinutes: toMinutes(lengthMs(interval)),
+  };
+}
+
+function slotsFor(
+  window: Interval,
+  bookings: Booking[],
+  minLengthMs: number,
+  max = Number.POSITIVE_INFINITY,
+): Slot[] {
+  if (!Number.isFinite(minLengthMs)) return [];
+  const gaps = freeGaps(window, bookings, minLengthMs);
+  return (Number.isFinite(max) ? gaps.slice(0, max) : gaps).map(toSlot);
+}
+
+/** When is this one room free? */
+export async function roomAvailability(
+  roomId: string,
+  query: AvailabilityInput,
+): Promise<RoomAvailability> {
+  const { window, durationMinutes, minLengthMs } = resolveQuery(query);
+
+  const room = await roomRepository.findById(roomId);
+  if (!room) {
+    throw notFound('Room');
+  }
+
+  const bookings = await bookingRepository.findActiveInRange(
+    [room.id],
+    window.startsAt,
+    window.endsAt,
+  );
+
+  return {
+    roomId: room.id,
+    from: window.startsAt,
+    to: window.endsAt,
+    durationMinutes,
+    slots: slotsFor(window, bookings, minLengthMs),
+    busy: bookings.map((booking) => ({
+      bookingId: booking.id,
+      startsAt: booking.startsAt,
+      endsAt: booking.endsAt,
+    })),
+  };
+}
+
+/** Which rooms can host a meeting of this length in this window? */
+export async function searchAvailability(
+  query: SearchAvailabilityInput,
+): Promise<AvailabilitySearch> {
+  const { window, durationMinutes, minLengthMs } = resolveQuery(query);
+  const limit = normalizeLimit(query.limit);
+  const offset = normalizeOffset(query.offset);
+
+  const rooms = await prisma.room.findMany({
+    where: query.capacity ? { capacity: { gte: query.capacity } } : {},
+    orderBy: [{ capacity: 'asc' }, { name: 'asc' }],
+  });
+
+  const bookings =
+    rooms.length === 0
+      ? []
+      : await bookingRepository.findActiveInRange(
+          rooms.map((room) => room.id),
+          window.startsAt,
+          window.endsAt,
+        );
+
+  const byRoom = new Map<string, Booking[]>();
+  for (const booking of bookings) {
+    const bucket = byRoom.get(booking.roomId);
+    if (bucket) bucket.push(booking);
+    else byRoom.set(booking.roomId, [booking]);
+  }
+
+  // Availability is derived, not stored, so the set has to be built before it
+  // can be paged. The room table is small enough for that to be fine.
+  const available = rooms
+    .map((room) => ({
+      room,
+      slots: slotsFor(window, byRoom.get(room.id) ?? [], minLengthMs, MAX_SLOTS_PER_ROOM),
+    }))
+    .filter((entry) => entry.slots.length > 0);
+
+  return {
+    from: window.startsAt,
+    to: window.endsAt,
+    durationMinutes,
+    data: available.slice(offset, offset + limit),
+    pagination: { total: available.length, limit, offset },
+  };
+}
