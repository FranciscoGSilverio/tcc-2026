+import type { FastifyPluginAsyncTypebox } from '@fastify/type-provider-typebox';
+import {
+  AvailabilityQuery,
+  RoomAvailabilityParams,
+  RoomAvailabilityResponse,
+  SearchAvailabilityQuery,
+  SearchAvailabilityResponse,
+} from './schema.js';
+import * as service from './service.js';
+
+export const availabilityRoutes: FastifyPluginAsyncTypebox = async (app) => {
+  app.get('/rooms/:roomId/availability',
+    {
+      schema: {
+        params: RoomAvailabilityParams,
+        querystring: AvailabilityQuery,
+        response: { 200: RoomAvailabilityResponse },
+      },
+    },
+    async (request) => service.roomAvailability(request.params.roomId, request.query));
+
+  app.get('/availability',
+    { schema: { querystring: SearchAvailabilityQuery, response: { 200: SearchAvailabilityResponse } } },
+    async (request) => service.searchAvailability(request.query));
+};
