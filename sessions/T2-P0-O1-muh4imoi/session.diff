+import { Type, type Static } from '@sinclair/typebox';
+import { RoomResponse } from '../rooms/schema.js';
+import { DateString } from '../../shared/schema.js';
+
+/** Window used when the caller does not give one. */
+export const DEFAULT_WINDOW_MS = 7 * 24 * 60 * 60 * 1000;
+/** Widest window we are willing to scan in one request. */
+export const MAX_WINDOW_MS = 31 * 24 * 60 * 60 * 1000;
+/** Free slots reported per room by the multi-room search. */
+export const MAX_SLOTS_PER_ROOM = 10;
+
+export const SlotResponse = Type.Object({
+  startsAt: DateString,
+  endsAt: DateString,
+  durationMinutes: Type.Integer(),
+});
+
+export const BusySlotResponse = Type.Object({
+  bookingId: Type.String(),
+  startsAt: DateString,
+  endsAt: DateString,
+});
+
+export const AvailabilityQuery = Type.Object({
+  from: Type.Optional(Type.String()),
+  to: Type.Optional(Type.String()),
+  durationMinutes: Type.Optional(Type.Integer({ minimum: 1 })),
+});
+
+export const RoomAvailabilityParams = Type.Object({
+  roomId: Type.String({ minLength: 1 }),
+});
+
+export const RoomAvailabilityResponse = Type.Object({
+  roomId: Type.String(),
+  from: DateString,
+  to: DateString,
+  durationMinutes: Type.Union([Type.Integer(), Type.Null()]),
+  slots: Type.Array(SlotResponse),
+  busy: Type.Array(BusySlotResponse),
+});
+
+export const SearchAvailabilityQuery = Type.Intersect([
+  AvailabilityQuery,
+  Type.Object({
+    capacity: Type.Optional(Type.Integer({ minimum: 1 })),
+    limit: Type.Optional(Type.Integer({ minimum: 1 })),
+    offset: Type.Optional(Type.Integer({ minimum: 0 })),
+  }),
+]);
+
+export const SearchAvailabilityResponse = Type.Object({
+  from: DateString,
+  to: DateString,
+  durationMinutes: Type.Union([Type.Integer(), Type.Null()]),
+  data: Type.Array(
+    Type.Object({
+      room: RoomResponse,
+      slots: Type.Array(SlotResponse),
+    }),
+  ),
+  pagination: Type.Object({
+    total: Type.Integer(),
+    limit: Type.Integer(),
+    offset: Type.Integer(),
+  }),
+});
+
+export type AvailabilityInput = Static<typeof AvailabilityQuery>;
+export type SearchAvailabilityInput = Static<typeof SearchAvailabilityQuery>;
