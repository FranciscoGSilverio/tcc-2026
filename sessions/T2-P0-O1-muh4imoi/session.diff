+describe('interval', () => {
+  const at = (hours: number) => new Date(Date.UTC(2030, 0, 1) + hours * 3_600_000);
+  const span = (from: number, to: number) => ({ startsAt: at(from), endsAt: at(to) });
+  const shape = (intervals: { startsAt: Date; endsAt: Date }[]) =>
+    intervals.map((i) => [i.startsAt.toISOString(), i.endsAt.toISOString()]);
+
+  it('treats intervals as half-open, so touching ones do not overlap', () => {
+    expect(overlaps(span(9, 10), span(10, 11))).toBe(false);
+    expect(overlaps(span(9, 10.5), span(10, 11))).toBe(true);
+  });
+
+  it('detects an overlap whichever side starts first', () => {
+    expect(overlaps(span(9, 11), span(10, 12))).toBe(true);
+    expect(overlaps(span(10, 12), span(9, 11))).toBe(true);
+  });
+
+  it('detects an interval enclosing another', () => {
+    expect(overlaps(span(8, 18), span(10, 11))).toBe(true);
+    expect(overlaps(span(10, 11), span(8, 18))).toBe(true);
+  });
+
+  it('collapses overlapping and touching intervals', () => {
+    expect(shape(merge([span(9, 10), span(10, 11), span(10.5, 12), span(14, 15)]))).toEqual(
+      shape([span(9, 12), span(14, 15)]),
+    );
+  });
+
+  it('reports the whole window as free when nothing is booked', () => {
+    expect(shape(freeGaps(span(9, 17), []))).toEqual(shape([span(9, 17)]));
+  });
+
+  it('carves busy intervals out of the window', () => {
+    expect(shape(freeGaps(span(9, 17), [span(10, 11), span(13, 14)]))).toEqual(
+      shape([span(9, 10), span(11, 13), span(14, 17)]),
+    );
+  });
+
+  it('clips busy intervals that run past the window edges', () => {
+    expect(shape(freeGaps(span(9, 17), [span(6, 10), span(16, 22)]))).toEqual(
+      shape([span(10, 16)]),
+    );
+  });
+
+  it('returns nothing when the window is fully booked', () => {
+    expect(freeGaps(span(9, 17), [span(8, 18)])).toEqual([]);
+  });
+
+  it('drops gaps shorter than the wanted duration', () => {
+    const gaps = freeGaps(span(9, 17), [span(9.5, 13), span(13.5, 17)], 60 * 60_000);
+    expect(shape(gaps)).toEqual(shape([]));
+    expect(shape(freeGaps(span(9, 17), [span(9.5, 13), span(14, 17)], 60 * 60_000))).toEqual(
+      shape([span(13, 14)]),
+    );
+  });
+
+  it('anchors fixed-length slots at the start of each free gap', () => {
+    const gaps = freeGaps(span(9, 17), [span(10, 11), span(13, 14)]);
+    expect(shape(slotsOfLength(gaps, 30 * 60_000, 2))).toEqual(
+      shape([span(9, 9.5), span(11, 11.5)]),
+    );
+  });
+
+  it('skips gaps that cannot fit the slot', () => {
+    const gaps = freeGaps(span(9, 17), [span(9.25, 13)]);
+    expect(shape(slotsOfLength(gaps, 60 * 60_000, 5))).toEqual(shape([span(13, 14)]));
+  });
+});
