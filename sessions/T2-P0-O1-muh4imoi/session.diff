+describe('batch booking', () => {
+  let app: FastifyInstance;
+  let roomId: string;
+  let otherRoomId: string;
+  let userId: string;
+
+  beforeAll(async () => {
+    app = await createTestApp();
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  beforeEach(async () => {
+    await resetDb();
+    roomId = (
+      await app.inject({ method: 'POST', url: '/rooms', payload: { name: 'Aurora', capacity: 6 } })
+    ).json().id;
+    otherRoomId = (
+      await app.inject({ method: 'POST', url: '/rooms', payload: { name: 'Borealis', capacity: 4 } })
+    ).json().id;
+    userId = (
+      await app.inject({
+        method: 'POST',
+        url: '/users',
+        payload: { name: 'Ada Lovelace', email: 'ada@example.com' },
+      })
+    ).json().id;
+  });
+
+  const item = (startHours: number, endHours: number, title = 'Sync', room = roomId) => ({
+    roomId: room,
+    userId,
+    title,
+    startsAt: inHours(startHours),
+    endsAt: inHours(endHours),
+  });
+
+  const batch = (bookings: ReturnType<typeof item>[]) =>
+    app.inject({ method: 'POST', url: '/bookings/batch', payload: { bookings } });
+
+  const countBookings = async () =>
+    (await app.inject({ method: 'GET', url: '/bookings' })).json().pagination.total;
+
+  it('creates a whole set of bookings at once', async () => {
+    const response = await batch([item(24, 25, 'A'), item(26, 27, 'B'), item(28, 29, 'C')]);
+    expect(response.statusCode).toBe(201);
+    expect(response.json().data).toHaveLength(3);
+    expect(await countBookings()).toBe(3);
+  });
+
+  it('creates nothing when one item conflicts with a stored booking', async () => {
+    await app.inject({ method: 'POST', url: '/bookings', payload: item(26, 27, 'Existing') });
+    const response = await batch([item(24, 25, 'A'), item(26.5, 27.5, 'B'), item(30, 31, 'C')]);
+    expect(response.statusCode).toBe(409);
+    // The pre-existing booking is the only one left: the batch rolled back.
+    expect(await countBookings()).toBe(1);
+  });
+
+  it('points at the offending item and what it clashes with', async () => {
+    const existing = await app.inject({
+      method: 'POST',
+      url: '/bookings',
+      payload: item(26, 27, 'Existing'),
+    });
+    const details = (await batch([item(24, 25, 'A'), item(26.5, 27.5, 'B')])).json().error.details;
+    expect(details.conflicts).toHaveLength(1);
+    expect(details.conflicts[0].index).toBe(1);
+    expect(details.conflicts[0].conflictingBookingId).toBe(existing.json().id);
+  });
+
+  it('reports every conflicting item in one response', async () => {
+    await app.inject({ method: 'POST', url: '/bookings', payload: item(24, 25, 'X') });
+    await app.inject({ method: 'POST', url: '/bookings', payload: item(30, 31, 'Y') });
+    const details = (
+      await batch([item(24.5, 25.5, 'A'), item(27, 28, 'B'), item(30.5, 31.5, 'C')])
+    ).json().error.details;
+    expect(details.conflicts.map((c: { index: number }) => c.index)).toEqual([0, 2]);
+  });
+
+  it('suggests alternatives for each conflicting item', async () => {
+    await app.inject({ method: 'POST', url: '/bookings', payload: item(24, 25, 'X') });
+    const details = (await batch([item(24.5, 25.5, 'A')])).json().error.details;
+    expect(details.conflicts[0].suggestions[0]).toEqual({
+      startsAt: inHours(25),
+      endsAt: inHours(26),
+    });
+  });
+
+  it('rejects a batch whose own items overlap each other', async () => {
+    const response = await batch([item(24, 26, 'A'), item(25, 27, 'B')]);
+    expect(response.statusCode).toBe(409);
+    expect(response.json().error.details.conflicts[0]).toMatchObject({
+      index: 1,
+      conflictsWithIndex: 0,
+    });
+    expect(await countBookings()).toBe(0);
+  });
+
+  it('allows items at the same time in different rooms', async () => {
+    const response = await batch([item(24, 25, 'A'), item(24, 25, 'B', otherRoomId)]);
+    expect(response.statusCode).toBe(201);
+    expect(await countBookings()).toBe(2);
+  });
+
+  it('allows back-to-back items in the same room', async () => {
+    const response = await batch([item(24, 25, 'A'), item(25, 26, 'B')]);
+    expect(response.statusCode).toBe(201);
+  });
+
+  it('reports which item has an unparseable instant', async () => {
+    const response = await app.inject({
+      method: 'POST',
+      url: '/bookings/batch',
+      payload: { bookings: [item(24, 25, 'A'), { ...item(26, 27, 'B'), startsAt: 'tomorrow' }] },
+    });
+    expect(response.statusCode).toBe(400);
+    expect(response.json().error.details.index).toBe(1);
+    expect(await countBookings()).toBe(0);
+  });
+
+  it('reports which item ends before it starts', async () => {
+    const response = await batch([item(24, 25, 'A'), item(27, 26, 'B')]);
+    expect(response.statusCode).toBe(400);
+    expect(response.json().error.details.index).toBe(1);
+  });
+
+  it('creates nothing when a room is unknown', async () => {
+    const response = await batch([item(24, 25, 'A'), item(26, 27, 'B', 'missing')]);
+    expect(response.statusCode).toBe(404);
+    expect(await countBookings()).toBe(0);
+  });
+
+  it('rejects an empty batch', async () => {
+    expect((await batch([])).statusCode).toBe(400);
+  });
+
+  it('rejects a batch beyond the size limit', async () => {
+    const many = Array.from({ length: 51 }, (_, i) => item(24 + i * 2, 25 + i * 2, `M${i}`));
+    expect((await batch(many)).statusCode).toBe(400);
+  });
+});
