+describe('conflict suggestions', () => {
+  let app: FastifyInstance;
+  let roomId: string;
+  let userId: string;
+
+  beforeAll(async () => {
+    app = await createTestApp();
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  beforeEach(async () => {
+    await resetDb();
+    roomId = (
+      await app.inject({ method: 'POST', url: '/rooms', payload: { name: 'Aurora', capacity: 6 } })
+    ).json().id;
+    userId = (
+      await app.inject({
+        method: 'POST',
+        url: '/users',
+        payload: { name: 'Ada Lovelace', email: 'ada@example.com' },
+      })
+    ).json().id;
+  });
+
+  const book = (startHours: number, endHours: number, title = 'Sync') =>
+    app.inject({
+      method: 'POST',
+      url: '/bookings',
+      payload: { roomId, userId, title, startsAt: inHours(startHours), endsAt: inHours(endHours) },
+    });
+
+  it('keeps reporting the booking that caused the conflict', async () => {
+    const first = await book(24, 25);
+    const response = await book(24.5, 25.5, 'Overlap');
+    expect(response.json().error.details.conflictingBookingId).toBe(first.json().id);
+  });
+
+  it('reports the period that is already taken', async () => {
+    await book(24, 25);
+    const details = (await book(24.5, 25.5, 'Overlap')).json().error.details;
+    expect(details.conflictingPeriod).toEqual({ startsAt: inHours(24), endsAt: inHours(25) });
+    expect(details.requestedPeriod).toEqual({ startsAt: inHours(24.5), endsAt: inHours(25.5) });
+  });
+
+  it('offers free slots of the requested length instead of making the caller guess', async () => {
+    await book(24, 25);
+    const details = (await book(24.5, 25.5, 'Overlap')).json().error.details;
+    // The hour is taken until 25, so the first slot of the same length starts there.
+    expect(details.suggestions[0]).toEqual({ startsAt: inHours(25), endsAt: inHours(26) });
+  });
+
+  it('skips gaps too small for the requested length', async () => {
+    await book(24, 25);
+    await book(25.5, 27, 'Next');
+    // Wanting 90 minutes: the 30-minute gap at 25 cannot hold it, so 27 wins.
+    const details = (await book(24.25, 24.25 + 1.5, 'Long one')).json().error.details;
+    expect(details.suggestions[0]).toEqual({ startsAt: inHours(27), endsAt: inHours(28.5) });
+  });
+
+  it('caps the number of suggestions', async () => {
+    await book(24, 25);
+    await book(26, 27, 'B');
+    await book(28, 29, 'C');
+    await book(30, 31, 'D');
+    await book(32, 33, 'E');
+    const details = (await book(24.5, 25.5, 'Overlap')).json().error.details;
+    expect(details.suggestions.length).toBeLessThanOrEqual(3);
+    expect(details.suggestions.length).toBeGreaterThan(0);
+  });
+
+  it('suggests a slot that can actually be booked', async () => {
+    await book(24, 25);
+    const details = (await book(24.5, 25.5, 'Overlap')).json().error.details;
+    const retry = await app.inject({
+      method: 'POST',
+      url: '/bookings',
+      payload: { roomId, userId, title: 'Retry', ...details.suggestions[0] },
+    });
+    expect(retry.statusCode).toBe(201);
+  });
+});
