+describe('availability endpoint', () => {
+  let app: FastifyInstance;
+  let roomId: string;
+  let userId: string;
+
+  beforeAll(async () => {
+    app = await createTestApp();
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  beforeEach(async () => {
+    await resetDb();
+    const room = await app.inject({
+      method: 'POST',
+      url: '/rooms',
+      payload: { name: 'Aurora', capacity: 6 },
+    });
+    roomId = room.json().id;
+    const user = await app.inject({
+      method: 'POST',
+      url: '/users',
+      payload: { name: 'Ada Lovelace', email: 'ada@example.com' },
+    });
+    userId = user.json().id;
+  });
+
+  async function book(from: number, to: number, room = roomId) {
+    return app.inject({
+      method: 'POST',
+      url: '/bookings',
+      payload: { roomId: room, userId, title: 'Sync', startsAt: at(from), endsAt: at(to) },
+    });
+  }
+
+  function availability(query: string) {
+    return app.inject({ method: 'GET', url: `/availability?${query}` });
+  }
+
+  it('reports the whole window as free for an empty room', async () => {
+    const response = await availability(`roomId=${roomId}&from=${at(9)}&to=${at(17)}`);
+    expect(response.statusCode).toBe(200);
+    expect(response.json().data[0].slots).toEqual([
+      { startsAt: at(9), endsAt: at(17), durationMinutes: 480 },
+    ]);
+  });
+
+  it('reports the gaps left by existing bookings', async () => {
+    await book(10, 11);
+    await book(13, 14);
+    const response = await availability(`roomId=${roomId}&from=${at(9)}&to=${at(17)}`);
+    expect(response.json().data[0].slots).toEqual([
+      { startsAt: at(9), endsAt: at(10), durationMinutes: 60 },
+      { startsAt: at(11), endsAt: at(13), durationMinutes: 120 },
+      { startsAt: at(14), endsAt: at(17), durationMinutes: 180 },
+    ]);
+  });
+
+  it('hides gaps that are shorter than the requested duration', async () => {
+    await book(10, 11);
+    await book(13, 14);
+    const response = await availability(
+      `roomId=${roomId}&from=${at(9)}&to=${at(17)}&durationMinutes=90`,
+    );
+    expect(
+      response
+        .json()
+        .data[0].slots.map((slot: { durationMinutes: number }) => slot.durationMinutes),
+    ).toEqual([120, 180]);
+  });
+
+  it('frees up the slot of a cancelled booking', async () => {
+    const created = await book(10, 11);
+    await app.inject({ method: 'POST', url: `/bookings/${created.json().id}/cancel` });
+    const response = await availability(`roomId=${roomId}&from=${at(9)}&to=${at(17)}`);
+    expect(response.json().data[0].slots).toHaveLength(1);
+  });
+
+  it('covers every room when no room is given', async () => {
+    await app.inject({
+      method: 'POST',
+      url: '/rooms',
+      payload: { name: 'Borealis', capacity: 12 },
+    });
+    const response = await availability(`from=${at(9)}&to=${at(17)}`);
+    expect(response.json().data).toHaveLength(2);
+    expect(response.json().pagination.total).toBe(2);
+  });
+
+  it('keeps a fully booked room in the page with no slots', async () => {
+    await book(9, 17);
+    const response = await availability(`roomId=${roomId}&from=${at(9)}&to=${at(17)}`);
+    expect(response.json().data[0].slots).toEqual([]);
+  });
+
+  it('does not let one room hide another room bookings', async () => {
+    const other = await app.inject({
+      method: 'POST',
+      url: '/rooms',
+      payload: { name: 'Borealis', capacity: 12 },
+    });
+    await book(10, 11, other.json().id);
+    const response = await availability(`from=${at(9)}&to=${at(17)}`);
+    const aurora = response
+      .json()
+      .data.find((entry: { room: { name: string } }) => entry.room.name === 'Aurora');
+    expect(aurora.slots).toHaveLength(1);
+  });
+
+  it('filters rooms by the capacity the caller needs', async () => {
+    await app.inject({
+      method: 'POST',
+      url: '/rooms',
+      payload: { name: 'Borealis', capacity: 12 },
+    });
+    const response = await availability(`from=${at(9)}&to=${at(17)}&minCapacity=10`);
+    expect(response.json().data).toHaveLength(1);
+    expect(response.json().data[0].room.name).toBe('Borealis');
+  });
+
+  it('echoes the window it searched', async () => {
+    const response = await availability(`roomId=${roomId}&from=${at(9)}&to=${at(17)}`);
+    expect(response.json().window).toEqual({
+      from: at(9),
+      to: at(17),
+      durationMinutes: 30,
+    });
+  });
+
+  it('defaults to a week starting now', async () => {
+    const response = await availability('');
+    const { from, to } = response.json().window;
+    expect(new Date(to).getTime() - new Date(from).getTime()).toBe(7 * 24 * HOUR);
+  });
+
+  it('answers 404 for a room that does not exist', async () => {
+    const response = await availability(`roomId=missing&from=${at(9)}&to=${at(17)}`);
+    expect(response.statusCode).toBe(404);
+  });
+
+  it('rejects a window that ends before it starts', async () => {
+    const response = await availability(`from=${at(17)}&to=${at(9)}`);
+    expect(response.statusCode).toBe(400);
+    expect(response.json().error.code).toBe('VALIDATION_ERROR');
+  });
+
+  it('rejects a window wider than the maximum', async () => {
+    const response = await availability(`from=${at(0)}&to=${at(24 * 40)}`);
+    expect(response.statusCode).toBe(400);
+  });
+
+  it('rejects a window boundary that cannot be parsed', async () => {
+    const response = await availability('from=tomorrow');
+    expect(response.statusCode).toBe(400);
+  });
+
+  it('paginates the rooms it reports on', async () => {
+    await app.inject({ method: 'POST', url: '/rooms', payload: { name: 'Borealis', capacity: 4 } });
+    await app.inject({ method: 'POST', url: '/rooms', payload: { name: 'Cosmos', capacity: 4 } });
+    const response = await availability(`from=${at(9)}&to=${at(17)}&limit=2&offset=2`);
+    expect(response.json().data).toHaveLength(1);
+    expect(response.json().pagination).toEqual({ total: 3, limit: 2, offset: 2 });
+  });
+});
