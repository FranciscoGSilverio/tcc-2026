+import type { FastifyPluginAsyncTypebox } from '@fastify/type-provider-typebox';
+import { AvailabilityPage, AvailabilityQuery } from './schema.js';
+import * as service from './service.js';
+
+export const availabilityRoutes: FastifyPluginAsyncTypebox = async (app) => {
+  app.get('/availability', { schema: { querystring: AvailabilityQuery, response: { 200: AvailabilityPage } } },
+    async (request) => service.findAvailability(request.query));
+};
