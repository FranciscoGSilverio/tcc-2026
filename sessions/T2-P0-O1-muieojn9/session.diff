+import { Type, type Static } from '@sinclair/typebox';
+import { DateString } from '../../shared/schema.js';
+
+/** Default search window when the caller does not pass `to`. */
+export const DEFAULT_WINDOW_DAYS = 7;
+export const MAX_WINDOW_DAYS = 31;
+export const DEFAULT_SLOT_MINUTES = 30;
+/** How many openings a booking conflict offers back to the client. */
+export const SUGGESTION_COUNT = 3;
+
+export const SlotResponse = Type.Object({
+  startsAt: DateString,
+  endsAt: DateString,
+  durationMinutes: Type.Integer(),
+});
+
+export const RoomAvailabilityResponse = Type.Object({
+  room: Type.Object({
+    id: Type.String(),
+    name: Type.String(),
+    capacity: Type.Integer(),
+    floor: Type.Union([Type.String(), Type.Null()]),
+  }),
+  slots: Type.Array(SlotResponse),
+});
+
+export const AvailabilityQuery = Type.Object({
+  roomId: Type.Optional(Type.String()),
+  from: Type.Optional(Type.String()),
+  to: Type.Optional(Type.String()),
+  durationMinutes: Type.Optional(Type.Integer({ minimum: 1 })),
+  minCapacity: Type.Optional(Type.Integer({ minimum: 1 })),
+  limit: Type.Optional(Type.Integer({ minimum: 1 })),
+  offset: Type.Optional(Type.Integer({ minimum: 0 })),
+});
+
+export const AvailabilityPage = Type.Object({
+  data: Type.Array(RoomAvailabilityResponse),
+  pagination: Type.Object({
+    total: Type.Integer(),
+    limit: Type.Integer(),
+    offset: Type.Integer(),
+  }),
+  window: Type.Object({
+    from: DateString,
+    to: DateString,
+    durationMinutes: Type.Integer(),
+  }),
+});
+
+export type AvailabilityInput = Static<typeof AvailabilityQuery>;
