+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'vitest';
+import type { FastifyInstance } from 'fastify';
+import { createTestApp, resetDb } from './helpers/app.js';
+import { freeSlots, openings } from '../src/modules/availability/slots.js';
+
+const HOUR = 3_600_000;
+const ANCHOR = Date.UTC(2030, 0, 1);
+
+function at(hours: number): string {
+  return new Date(ANCHOR + hours * HOUR).toISOString();
+}
+
+function interval(from: number, to: number) {
+  return { startsAt: new Date(ANCHOR + from * HOUR), endsAt: new Date(ANCHOR + to * HOUR) };
+}
+
+describe('free slot arithmetic', () => {
+  it('returns the whole window when nothing is booked', () => {
+    expect(freeSlots(interval(9, 17), [], 0)).toEqual([
+      {
+        startsAt: new Date(ANCHOR + 9 * HOUR),
+        endsAt: new Date(ANCHOR + 17 * HOUR),
+        durationMinutes: 480,
+      },
+    ]);
+  });
+
+  it('returns nothing when the window is fully booked', () => {
+    expect(freeSlots(interval(9, 17), [interval(9, 17)], 0)).toEqual([]);
+  });
+
+  it('carves the gaps between bookings', () => {
+    const slots = freeSlots(interval(9, 17), [interval(10, 11), interval(13, 14)], 0);
+    expect(slots.map((slot) => slot.durationMinutes)).toEqual([60, 120, 180]);
+  });
+
+  it('clips bookings that hang over the edges of the window', () => {
+    const slots = freeSlots(interval(9, 17), [interval(7, 10), interval(16, 20)], 0);
+    expect(slots).toEqual([
+      {
+        startsAt: new Date(ANCHOR + 10 * HOUR),
+        endsAt: new Date(ANCHOR + 16 * HOUR),
+        durationMinutes: 360,
+      },
+    ]);
+  });
+
+  it('ignores a booking that sits entirely after the window', () => {
+    const slots = freeSlots(interval(9, 17), [interval(20, 22)], 0);
+    expect(slots).toEqual([
+      {
+        startsAt: new Date(ANCHOR + 9 * HOUR),
+        endsAt: new Date(ANCHOR + 17 * HOUR),
+        durationMinutes: 480,
+      },
+    ]);
+  });
+
+  it('ignores a booking that sits entirely before the window', () => {
+    const slots = freeSlots(interval(9, 17), [interval(5, 7)], 0);
+    expect(slots.map((slot) => slot.durationMinutes)).toEqual([480]);
+  });
+
+  // Reversed rows exist in data written before the interval was validated.
+  it('ignores a busy interval that ends before it starts', () => {
+    const slots = freeSlots(interval(9, 17), [interval(14, 12)], 0);
+    expect(slots.map((slot) => slot.durationMinutes)).toEqual([480]);
+  });
+
+  it('merges bookings that overlap each other', () => {
+    const slots = freeSlots(interval(9, 17), [interval(10, 14), interval(11, 13)], 0);
+    expect(slots.map((slot) => slot.durationMinutes)).toEqual([60, 180]);
+  });
+
+  it('merges bookings that are nested inside one another', () => {
+    const slots = freeSlots(interval(9, 17), [interval(10, 16), interval(11, 12)], 0);
+    expect(slots.map((slot) => slot.durationMinutes)).toEqual([60, 60]);
+  });
+
+  it('drops gaps shorter than the requested duration', () => {
+    const slots = freeSlots(interval(9, 17), [interval(10, 11), interval(13, 14)], 90 * 60_000);
+    expect(slots.map((slot) => slot.durationMinutes)).toEqual([120, 180]);
+  });
+
+  it('trims free slots down to openings of the requested length', () => {
+    const slots = freeSlots(interval(9, 17), [interval(10, 11)], 0);
+    expect(openings(slots, HOUR, 5).map((slot) => slot.durationMinutes)).toEqual([60, 60]);
+  });
+
+  it('caps the number of openings it hands back', () => {
+    const slots = freeSlots(interval(9, 17), [interval(10, 11), interval(13, 14)], 0);
+    expect(openings(slots, 30 * 60_000, 2)).toHaveLength(2);
+  });
+});
