index 0000000..6caa019
--- /dev/null
+++ b/src/modules/availability/slots.ts
@@ -0,0 +1,56 @@
+import { durationMinutes, maxDate, minDate, type Interval } from '../../shared/time.js';
+
+export interface Slot {
+  startsAt: Date;
+  endsAt: Date;
+  durationMinutes: number;
+}
+
+function slot(startsAt: Date, endsAt: Date): Slot {
+  return { startsAt, endsAt, durationMinutes: durationMinutes(startsAt, endsAt) };
+}
+
+/** A gap is only worth reporting when it is non-empty and long enough to use. */
+function fits(from: Date, to: Date, minDurationMs: number): boolean {
+  const gap = to.getTime() - from.getTime();
+  return gap > 0 && gap >= minDurationMs;
+}
+
+/**
+ * Walks the window left to right and returns the gaps the busy intervals leave
+ * behind, keeping only the ones at least `minDurationMs` long.
+ *
+ * `busy` must be sorted by start. Intervals may overlap each other and may
+ * stick out of the window on either side: the cursor only ever moves forward,
+ * which merges them as it goes.
+ */
+export function freeSlots(window: Interval, busy: Interval[], minDurationMs: number): Slot[] {
+  const slots: Slot[] = [];
+  let cursor = window.startsAt;
+
+  for (const interval of busy) {
+    const start = maxDate(interval.startsAt, window.startsAt);
+    const end = minDate(interval.endsAt, window.endsAt);
+    if (end.getTime() <= start.getTime()) continue;
+    if (fits(cursor, start, minDurationMs)) {
+      slots.push(slot(cursor, start));
+    }
+    cursor = maxDate(cursor, end);
+  }
+
+  if (fits(cursor, window.endsAt, minDurationMs)) {
+    slots.push(slot(cursor, window.endsAt));
+  }
+
+  return slots;
+}
+
+/**
+ * Trims free slots down to bookable openings of exactly `durationMs`, anchored
+ * at the start of each slot, so a client can post one back unchanged.
+ */
+export function openings(slots: Slot[], durationMs: number, limit: number): Slot[] {
+  return slots
+    .slice(0, limit)
+    .map((free) => slot(free.startsAt, new Date(free.startsAt.getTime() + durationMs)));
+}
