+import type { Room } from '@prisma/client';
+import { notFound, validationFailed, type SuggestedSlot } from '../../shared/errors.js';
+import { normalizeLimit, normalizeOffset, paginated } from '../../shared/pagination.js';
+import { minutesToMs, parseInstant, requireOrdered, type Interval } from '../../shared/time.js';
+import * as bookings from '../bookings/repository.js';
+import * as rooms from '../rooms/repository.js';
+import {
+  DEFAULT_SLOT_MINUTES,
+  DEFAULT_WINDOW_DAYS,
+  MAX_WINDOW_DAYS,
+  SUGGESTION_COUNT,
+  type AvailabilityInput,
+} from './schema.js';
+import { freeSlots, openings, type Slot } from './slots.js';
+
+const DAY_IN_MS = 24 * 60 * minutesToMs(1);
+
+export interface RoomAvailability {
+  room: Pick<Room, 'id' | 'name' | 'capacity' | 'floor'>;
+  slots: Slot[];
+}
+
+export interface AvailabilityPage {
+  data: RoomAvailability[];
+  pagination: { total: number; limit: number; offset: number };
+  window: { from: Date; to: Date; durationMinutes: number };
+}
+
+function resolveWindow(query: AvailabilityInput): Interval {
+  const startsAt = query.from ? parseInstant(query.from) : new Date();
+  const endsAt = query.to
+    ? parseInstant(query.to)
+    : new Date(startsAt.getTime() + DEFAULT_WINDOW_DAYS * DAY_IN_MS);
+  requireOrdered({ startsAt, endsAt });
+
+  if (endsAt.getTime() - startsAt.getTime() > MAX_WINDOW_DAYS * DAY_IN_MS) {
+    throw validationFailed('Search window is too wide', { maxDays: MAX_WINDOW_DAYS });
+  }
+  return { startsAt, endsAt };
+}
+
+async function roomsInScope(
+  query: AvailabilityInput,
+  limit: number,
+  offset: number,
+): Promise<[Room[], number]> {
+  if (query.roomId === undefined) {
+    return rooms.list({ minCapacity: query.minCapacity, limit, offset });
+  }
+  const room = await rooms.findById(query.roomId);
+  if (!room) {
+    throw notFound('Room');
+  }
+  return [[room], 1];
+}
+
+/**
+ * Free slots per room for a time window. Rooms that are fully booked are still
+ * listed, with an empty `slots` array, so the page totals stay meaningful.
+ */
+export async function findAvailability(query: AvailabilityInput): Promise<AvailabilityPage> {
+  const window = resolveWindow(query);
+  const slotMinutes = query.durationMinutes ?? DEFAULT_SLOT_MINUTES;
+  const limit = normalizeLimit(query.limit);
+  const offset = normalizeOffset(query.offset);
+
+  const [scope, total] = await roomsInScope(query, limit, offset);
+  const busy = await bookings.findActiveOverlapping(
+    scope.map((room) => room.id),
+    window,
+  );
+
+  const data = scope.map((room) => ({
+    room: { id: room.id, name: room.name, capacity: room.capacity, floor: room.floor },
+    slots: freeSlots(
+      window,
+      busy.filter((booking) => booking.roomId === room.id),
+      minutesToMs(slotMinutes),
+    ),
+  }));
+
+  return {
+    ...paginated(data, total, limit, offset),
+    window: { from: window.startsAt, to: window.endsAt, durationMinutes: slotMinutes },
+  };
+}
+
+/**
+ * The next few openings of the requested length in a room, starting at `from`.
+ * Used to answer a booking conflict with times that are actually free.
+ */
+export async function suggestOpenings(
+  roomId: string,
+  from: Date,
+  durationMs: number,
+  count = SUGGESTION_COUNT,
+): Promise<SuggestedSlot[]> {
+  const window = {
+    startsAt: from,
+    endsAt: new Date(from.getTime() + DEFAULT_WINDOW_DAYS * DAY_IN_MS),
+  };
+  const busy = await bookings.findActiveOverlapping([roomId], window);
+  return openings(freeSlots(window, busy, durationMs), durationMs, count).map((slot) => ({
+    startsAt: slot.startsAt.toISOString(),
+    endsAt: slot.endsAt.toISOString(),
+  }));
+}
