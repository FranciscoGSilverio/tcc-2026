+/**
+ * Parses a half-open interval [startsAt, endsAt). Empty and reversed intervals
+ * are rejected: they cannot be booked and they make slot arithmetic meaningless.
+ */
+export function parseInterval(startsAt: string, endsAt: string): Interval {
+  const interval = { startsAt: parseInstant(startsAt), endsAt: parseInstant(endsAt) };
+  requireOrdered(interval);
+  return interval;
+}
+
+export function requireOrdered(interval: Interval): Interval {
+  if (!isBefore(interval.startsAt, interval.endsAt)) {
+    throw validationFailed('endsAt must be after startsAt', {
+      startsAt: interval.startsAt.toISOString(),
+      endsAt: interval.endsAt.toISOString(),
+    });
+  }
+  return interval;
+}
+
 export function durationMinutes(start: Date, end: Date): number {
   return Math.round((end.getTime() - start.getTime()) / MINUTE_IN_MS);
 }
 
+export function minutesToMs(minutes: number): number {
+  return minutes * MINUTE_IN_MS;
+}
+
 export function isBefore(a: Date, b: Date): boolean {
   return a.getTime() < b.getTime();
 }
+
+export function maxDate(a: Date, b: Date): Date {
+  return isBefore(a, b) ? b : a;
+}
+
+export function minDate(a: Date, b: Date): Date {
+  return isBefore(a, b) ? a : b;
+}
