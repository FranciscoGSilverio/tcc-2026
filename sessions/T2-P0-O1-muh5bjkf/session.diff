+/** Parses a half-open range and rejects it unless it moves forward in time. */
+export function parseRange(
+  start: string,
+  end: string,
+  startField = 'startsAt',
+  endField = 'endsAt',
+): Interval {
+  const startsAt = parseInstant(start);
+  const endsAt = parseInstant(end);
+  if (!isBefore(startsAt, endsAt)) {
+    throw validationFailed(`${endField} must be after ${startField}`, {
+      [startField]: start,
+      [endField]: end,
+    });
+  }
+  return { startsAt, endsAt };
+}
+
 export function durationMinutes(start: Date, end: Date): number {
   return Math.round((end.getTime() - start.getTime()) / MINUTE_IN_MS);
 }
