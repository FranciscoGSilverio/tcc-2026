+      await book(borealis, 20, 40);
+      const body = (await search('')).json();
+      expect(body.data).toEqual([]);
+      expect(body.pagination.total).toBe(0);
+    });
+
+    it('ignores an unknown query parameter rather than failing', async () => {
+      const response = await search('capacity=8');
+      expect(response.statusCode).toBe(200);
+      expect(response.json().pagination.total).toBe(2);
+    });
+  });
+
+  describe('booking a slot it offered', () => {
+    it('accepts the slot the API pointed at', async () => {
+      await book(aurora, 26, 30);
+      const [slot] = (await roomSlots(aurora, `from=${inHours(24)}&to=${inHours(36)}&durationMinutes=60`))
+        .json().slots;
+
+      const response = await app.inject({
+        method: 'POST',
+        url: '/bookings',
+        payload: { roomId: aurora, userId, title: 'Booked from availability', ...slot },
+      });
+      expect(response.statusCode).toBe(201);
+    });
