+    });
+
+    it('requires a window at all', async () => {
+      const response = await app.inject({ method: 'GET', url: `/rooms/${aurora}/availability` });
+      expect(response.statusCode).toBe(400);
+    });
+  });
+
+  describe('across rooms', () => {
+    it('lists every free room in the window', async () => {
+      const body = (await search('')).json();
+      expect(body.data.map((entry: { room: { name: string } }) => entry.room.name)).toEqual([
+        'Aurora',
+        'Borealis',
+      ]);
+      expect(body.pagination.total).toBe(2);
+    });
+
+    it('leaves out a room with nothing free', async () => {
+      await book(aurora, 20, 40);
+      const body = (await search('')).json();
+      expect(body.data).toHaveLength(1);
+      expect(body.data[0].room.name).toBe('Borealis');
+      expect(body.pagination.total).toBe(1);
+    });
+
+    it('leaves out a room too small for the meeting', async () => {
+      const body = (await search('minCapacity=8')).json();
+      expect(body.data).toHaveLength(1);
+      expect(body.data[0].room.name).toBe('Aurora');
+    });
+
+    it('leaves out a room without a long enough gap', async () => {
+      await book(borealis, 25, 35);
+      const body = (await search('durationMinutes=180')).json();
+      expect(body.data.map((entry: { room: { name: string } }) => entry.room.name)).toEqual([
+        'Aurora',
+      ]);
+    });
+
+    it('returns each free gap of the rooms it lists', async () => {
+      await book(aurora, 26, 27);
+      const body = (await search('')).json();
+      expect(asOffsets(body.data[0].slots)).toEqual([
+        [24, 26],
+        [27, 36],
+      ]);
+    });
+
+    it('caps how many slots it shows per room', async () => {
+      await book(aurora, 26, 27);
+      await book(aurora, 30, 31);
+      const body = (await search('slotsPerRoom=1')).json();
+      expect(body.data[0].slots).toHaveLength(1);
+    });
+
+    it('pages over the rooms while keeping the true total', async () => {
