+import type { Room } from '@prisma/client';
+import { notFound, validationFailed } from '../../shared/errors.js';
+import {
+  normalizeLimit,
+  normalizeOffset,
+  type Page,
+} from '../../shared/pagination.js';
+import { freeSlots, type Interval, type Slot } from '../../shared/slots.js';
+import { durationMinutes, MINUTE_IN_MS, parseRange } from '../../shared/time.js';
+import * as bookings from '../bookings/repository.js';
+import * as rooms from '../rooms/repository.js';
+import type { RoomAvailabilityInput, SearchAvailabilityInput } from './schema.js';
+
+/** Widest window a single query may span, so one request cannot scan the whole calendar. */
+export const MAX_WINDOW_DAYS = 31;
+const MAX_WINDOW_MS = MAX_WINDOW_DAYS * 24 * 60 * MINUTE_IN_MS;
+
+/** How far ahead a rejected booking looks for alternatives, and how many it offers. */
+const SUGGESTION_HORIZON_MS = 7 * 24 * 60 * 60_000;
+const SUGGESTION_COUNT = 3;
+
+const DEFAULT_SLOTS_PER_ROOM = 3;
+
+export interface RoomAvailability {
+  roomId: string;
+  from: Date;
+  to: Date;
+  slots: Slot[];
+}
+
+export interface RoomWithSlots {
+  room: Room;
+  slots: Slot[];
+}
+
+function toSlot(interval: Interval): Slot {
+  return {
+    startsAt: interval.startsAt,
+    endsAt: interval.endsAt,
+    durationMinutes: durationMinutes(interval.startsAt, interval.endsAt),
+  };
+}
+
+function parseWindow(from: string, to: string): Interval {
+  const window = parseRange(from, to, 'from', 'to');
+  if (window.endsAt.getTime() - window.startsAt.getTime() > MAX_WINDOW_MS) {
+    throw validationFailed(`The window cannot be wider than ${MAX_WINDOW_DAYS} days`, { from, to });
+  }
+  return window;
+}
+
+/** Free gaps of a single room inside the window, longest-lived order (chronological). */
+export async function getRoomAvailability(
+  roomId: string,
+  query: RoomAvailabilityInput,
+): Promise<RoomAvailability> {
+  const window = parseWindow(query.from, query.to);
+  if (!(await rooms.findById(roomId))) {
+    throw notFound('Room');
+  }
+
+  const busy = await bookings.findActiveInWindow([roomId], window);
+  const minimum = (query.durationMinutes ?? 0) * MINUTE_IN_MS;
+  const slots = freeSlots(window, busy, minimum).slice(0, normalizeLimit(query.limit));
+
+  return { roomId, from: window.startsAt, to: window.endsAt, slots: slots.map(toSlot) };
+}
+
+/**
+ * Rooms that still have a free gap inside the window. Every room matching the
+ * capacity filter is considered, so `total` is the exact number of free rooms.
+ */
+export async function searchAvailability(
+  query: SearchAvailabilityInput,
+): Promise<Page<RoomWithSlots> & { from: Date; to: Date }> {
+  const window = parseWindow(query.from, query.to);
+  const limit = normalizeLimit(query.limit);
+  const offset = normalizeOffset(query.offset);
+  const slotsPerRoom = query.slotsPerRoom ?? DEFAULT_SLOTS_PER_ROOM;
+  const minimum = (query.durationMinutes ?? 0) * MINUTE_IN_MS;
+
+  const candidates = await rooms.findByMinCapacity(query.minCapacity);
+  const busyByRoom = new Map<string, Interval[]>();
+  if (candidates.length > 0) {
+    for (const booking of await bookings.findActiveInWindow(
+      candidates.map((room) => room.id),
+      window,
+    )) {
+      const current = busyByRoom.get(booking.roomId);
+      if (current) current.push(booking);
+      else busyByRoom.set(booking.roomId, [booking]);
+    }
+  }
+
+  const available: RoomWithSlots[] = [];
+  for (const room of candidates) {
+    const slots = freeSlots(window, busyByRoom.get(room.id) ?? [], minimum);
+    if (slots.length > 0) {
+      available.push({ room, slots: slots.slice(0, slotsPerRoom).map(toSlot) });
+    }
+  }
+
+  return {
+    from: window.startsAt,
+    to: window.endsAt,
+    data: available.slice(offset, offset + limit),
+    pagination: { total: available.length, limit, offset },
+  };
+}
+
+/**
+ * Alternatives for a booking that was refused: the next free slots of the same
+ * length in the same room, starting from the time the client asked for.
+ */
+export async function suggestSlots(roomId: string, wanted: Interval): Promise<Slot[]> {
+  const length = wanted.endsAt.getTime() - wanted.startsAt.getTime();
+  const window = {
+    startsAt: wanted.startsAt,
+    endsAt: new Date(wanted.startsAt.getTime() + SUGGESTION_HORIZON_MS),
+  };
+  const busy = await bookings.findActiveInWindow([roomId], window);
+
+  return freeSlots(window, busy, length)
+    .slice(0, SUGGESTION_COUNT)
+    .map((gap) => toSlot({ startsAt: gap.startsAt, endsAt: new Date(gap.startsAt.getTime() + length) }));
+}
