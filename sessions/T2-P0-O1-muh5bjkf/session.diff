--- /dev/null
+++ b/src/shared/slots.ts
@@ -0,0 +1,63 @@
+export interface Interval {
+  startsAt: Date;
+  endsAt: Date;
+}
+
+/** Intervals are half-open: [startsAt, endsAt). Touching intervals do not overlap. */
+export function overlaps(a: Interval, b: Interval): boolean {
+  return a.startsAt.getTime() < b.endsAt.getTime() && a.endsAt.getTime() > b.startsAt.getTime();
+}
+
+/** Collapses overlapping or touching intervals into the smallest equivalent sorted set. */
+export function mergeIntervals(intervals: Interval[]): Interval[] {
+  const sorted = [...intervals].sort((a, b) => a.startsAt.getTime() - b.startsAt.getTime());
+  const merged: Interval[] = [];
+
+  for (const current of sorted) {
+    const last = merged[merged.length - 1];
+    if (last && current.startsAt.getTime() <= last.endsAt.getTime()) {
+      if (current.endsAt.getTime() > last.endsAt.getTime()) {
+        merged[merged.length - 1] = { startsAt: last.startsAt, endsAt: current.endsAt };
+      }
+      continue;
+    }
+    merged.push({ startsAt: current.startsAt, endsAt: current.endsAt });
+  }
+
+  return merged;
+}
+
+/**
+ * Returns the gaps left inside `window` once every `busy` interval is removed.
+ * Slots shorter than `minDurationMs` are dropped; zero-length gaps never qualify.
+ */
+export function freeSlots(window: Interval, busy: Interval[], minDurationMs = 0): Interval[] {
+  const windowEnd = window.endsAt.getTime();
+  const minimum = Math.max(minDurationMs, 1);
+  const slots: Interval[] = [];
+  let cursor = window.startsAt.getTime();
+
+  const collect = (from: number, to: number): void => {
+    if (to - from >= minimum) {
+      slots.push({ startsAt: new Date(from), endsAt: new Date(to) });
+    }
+  };
+
+  for (const interval of mergeIntervals(busy)) {
+    const busyStart = interval.startsAt.getTime();
+    const busyEnd = interval.endsAt.getTime();
+    if (busyEnd <= cursor) continue;
+    if (busyStart >= windowEnd) break;
+    if (busyStart > cursor) collect(cursor, Math.min(busyStart, windowEnd));
+    cursor = busyEnd;
+    if (cursor >= windowEnd) return slots;
+  }
+
+  collect(cursor, windowEnd);
+  return slots;
+}
+
+/** A free interval offered back to a client, with its length precomputed. */
+export interface Slot extends Interval {
+  durationMinutes: number;
+}
