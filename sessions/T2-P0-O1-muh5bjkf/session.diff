+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'vitest';
+import type { FastifyInstance } from 'fastify';
+import { createTestApp, resetDb } from './helpers/app.js';
+
+const HOUR = 3_600_000;
+// Anchored once so the same offset always names the same instant in a run.
+const BASE = Date.now();
+
+const inHours = (hours: number): string => new Date(BASE + hours * HOUR).toISOString();
+const offsetOf = (iso: string): number => Math.round((new Date(iso).getTime() - BASE) / HOUR);
+
+interface Slot {
+  startsAt: string;
+  endsAt: string;
+  durationMinutes: number;
+}
+
+const asOffsets = (slots: Slot[]): number[][] =>
+  slots.map((slot) => [offsetOf(slot.startsAt), offsetOf(slot.endsAt)]);
+
+describe('availability', () => {
+  let app: FastifyInstance;
+  let aurora: string;
+  let borealis: string;
+  let userId: string;
+
+  beforeAll(async () => {
+    app = await createTestApp();
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  beforeEach(async () => {
+    await resetDb();
+    aurora = (
+      await app.inject({
+        method: 'POST',
+        url: '/rooms',
+        payload: { name: 'Aurora', capacity: 10 },
+      })
+    ).json().id;
+    borealis = (
+      await app.inject({
+        method: 'POST',
+        url: '/rooms',
+        payload: { name: 'Borealis', capacity: 4 },
+      })
+    ).json().id;
+    userId = (
+      await app.inject({
+        method: 'POST',
+        url: '/users',
+        payload: { name: 'Ada Lovelace', email: 'ada@example.com' },
+      })
+    ).json().id;
+  });
+
+  const book = (room: string, s: number, e: number, title = 'Sync') =>
+    app.inject({
+      method: 'POST',
+      url: '/bookings',
+      payload: { roomId: room, userId, title, startsAt: inHours(s), endsAt: inHours(e) },
+    });
+
+  const roomSlots = (room: string, query = `from=${inHours(24)}&to=${inHours(36)}`) =>
+    app.inject({ method: 'GET', url: `/rooms/${room}/availability?${query}` });
+
+  const search = (query: string) =>
+    app.inject({ method: 'GET', url: `/availability?from=${inHours(24)}&to=${inHours(36)}&${query}` });
+
+  describe('for a single room', () => {
+    it('offers the whole window when the room is free', async () => {
+      const response = await roomSlots(aurora);
+      expect(response.statusCode).toBe(200);
+      expect(asOffsets(response.json().slots)).toEqual([[24, 36]]);
+    });
+
+    it('carves the window around the bookings', async () => {
+      await book(aurora, 26, 27);
+      await book(aurora, 30, 32);
+      expect(asOffsets((await roomSlots(aurora)).json().slots)).toEqual([
+        [24, 26],
+        [27, 30],
+        [32, 36],
+      ]);
+    });
+
+    it('reports the length of each slot', async () => {
+      await book(aurora, 26, 27);
+      expect((await roomSlots(aurora)).json().slots[0].durationMinutes).toBe(120);
+    });
