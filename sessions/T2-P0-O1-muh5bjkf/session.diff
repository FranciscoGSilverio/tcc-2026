+import { Type, type Static } from '@sinclair/typebox';
+import { RoomResponse } from '../rooms/schema.js';
+import { DateString } from '../../shared/schema.js';
+
+export const SlotResponse = Type.Object({
+  startsAt: DateString,
+  endsAt: DateString,
+  durationMinutes: Type.Integer(),
+});
+
+const WindowQuery = {
+  from: Type.String({ minLength: 1 }),
+  to: Type.String({ minLength: 1 }),
+  durationMinutes: Type.Optional(Type.Integer({ minimum: 1 })),
+};
+
+export const RoomAvailabilityParams = Type.Object({ roomId: Type.String({ minLength: 1 }) });
+
+export const RoomAvailabilityQuery = Type.Object(
+  { ...WindowQuery, limit: Type.Optional(Type.Integer({ minimum: 1 })) },
+  { additionalProperties: false },
+);
+
+export const RoomAvailabilityResponse = Type.Object({
+  roomId: Type.String(),
+  from: DateString,
+  to: DateString,
+  slots: Type.Array(SlotResponse),
+});
+
+export const SearchAvailabilityQuery = Type.Object(
+  {
+    ...WindowQuery,
+    minCapacity: Type.Optional(Type.Integer({ minimum: 1 })),
+    slotsPerRoom: Type.Optional(Type.Integer({ minimum: 1, maximum: 20 })),
+    limit: Type.Optional(Type.Integer({ minimum: 1 })),
+    offset: Type.Optional(Type.Integer({ minimum: 0 })),
+  },
+  { additionalProperties: false },
+);
+
+export const SearchAvailabilityResponse = Type.Object({
+  from: DateString,
+  to: DateString,
+  data: Type.Array(Type.Object({ room: RoomResponse, slots: Type.Array(SlotResponse) })),
+  pagination: Type.Object({
+    total: Type.Integer(),
+    limit: Type.Integer(),
+    offset: Type.Integer(),
+  }),
+});
+
+export type RoomAvailabilityInput = Static<typeof RoomAvailabilityQuery>;
+export type SearchAvailabilityInput = Static<typeof SearchAvailabilityQuery>;
