+export async function getRoomAvailability(input: AvailabilityInput): Promise<RoomAvailability> {
+  const from = parseInstant(input.from);
+  const to = parseInstant(input.to);
+  if (!isBefore(from, to)) {
+    throw validationFailed('"from" must be before "to"', { from: input.from, to: input.to });
+  }
+
+  await roomsService.getRoom(input.roomId);
+
+  const bookings = await repository.listActiveInRange(input.roomId, from, to);
+
+  const slots: AvailabilitySlot[] = [];
+  let cursor = from;
+  for (const booking of bookings) {
+    const bookedStart = isBefore(cursor, booking.startsAt) ? booking.startsAt : cursor;
+    const bookedEnd = isBefore(booking.endsAt, to) ? booking.endsAt : to;
+    if (isBefore(cursor, bookedStart)) {
+      slots.push({ startsAt: cursor, endsAt: bookedStart });
+    }
+    if (isBefore(cursor, bookedEnd)) {
+      cursor = bookedEnd;
+    }
+  }
+  if (isBefore(cursor, to)) {
+    slots.push({ startsAt: cursor, endsAt: to });
+  }
+
+  return { roomId: input.roomId, from, to, slots };
+}
