+
+function clip(value: Date, from: Date, to: Date): Date {
+  if (isBefore(value, from)) return from;
+  if (isBefore(to, value)) return to;
+  return value;
+}
+
+export async function getAvailability(query: AvailabilityInput): Promise<AvailabilityResult> {
+  const from = parseInstant(query.from);
+  const to = parseInstant(query.to);
+  if (!isBefore(from, to)) {
+    throw validationFailed('to must be after from', { from: query.from, to: query.to });
+  }
+
+  const room = await repository.findRoomById(query.roomId);
+  if (!room) {
+    throw notFound('Room');
+  }
+
+  const overlapping = await repository.findOverlapping(query.roomId, from, to);
+  const busy = overlapping.map((booking) => ({
+    bookingId: booking.id,
+    startsAt: clip(booking.startsAt, from, to),
+    endsAt: clip(booking.endsAt, from, to),
+  }));
+
+  const free: AvailabilityResult['free'] = [];
+  let cursor = from;
+  for (const slot of busy) {
+    if (isBefore(cursor, slot.startsAt)) {
+      free.push({ startsAt: cursor, endsAt: slot.startsAt });
+    }
+    if (isBefore(cursor, slot.endsAt)) {
+      cursor = slot.endsAt;
+    }
+  }
+  if (isBefore(cursor, to)) {
+    free.push({ startsAt: cursor, endsAt: to });
+  }
+
+  return { roomId: query.roomId, from, to, busy, free };
+}
