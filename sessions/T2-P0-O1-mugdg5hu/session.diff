+
+export interface TimeSlot {
+  startsAt: Date;
+  endsAt: Date;
+}
+
+export interface AvailableSlotsResponse {
+  roomId: string;
+  slots: TimeSlot[];
+}
+
+export async function getAvailableSlots(
+  roomId: string,
+  from: Date,
+  to: Date,
+): Promise<AvailableSlotsResponse> {
+  const bookings = await repository.findConflictsInRange(roomId, from, to);
+
+  const slots: TimeSlot[] = [];
+  let currentStart = from;
+
+  for (const booking of bookings) {
+    if (currentStart < booking.startsAt) {
+      slots.push({
+        startsAt: currentStart,
+        endsAt: booking.startsAt,
+      });
+    }
+    currentStart = booking.endsAt;
+  }
+
+  if (currentStart < to) {
+    slots.push({
+      startsAt: currentStart,
+      endsAt: to,
+    });
+  }
+
+  return {
+    roomId,
+    slots: slots.map((slot) => ({
+      startsAt: slot.startsAt.toISOString(),
+      endsAt: slot.endsAt.toISOString(),
+    })) as any,
+  };
+}
