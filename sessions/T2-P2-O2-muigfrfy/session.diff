+const MINUTES_IN_DAY = 1440;
+const MAX_WINDOW_MINUTES = 31 * MINUTES_IN_DAY;
+const SUGGESTION_WINDOW_MINUTES = 7 * MINUTES_IN_DAY;
+
+export interface Slot {
