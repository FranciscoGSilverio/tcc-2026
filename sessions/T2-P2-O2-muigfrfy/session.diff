 export async function updateBooking(id: string, input: UpdateBookingInput): Promise<Booking> {
-  await getBooking(id);
+  const booking = await getBooking(id);
+  const roomId = input.roomId ?? booking.roomId;
+  const startsAt = input.startsAt !== undefined ? parseInstant(input.startsAt) : booking.startsAt;
+  const endsAt = input.endsAt !== undefined ? parseInstant(input.endsAt) : booking.endsAt;
+  const reschedules =
+    input.roomId !== undefined || input.startsAt !== undefined || input.endsAt !== undefined;
+
+  if (input.userId !== undefined) {
+    await assertUserExists(input.userId);
+  }
+
+  if (reschedules) {
+    assertWindow(startsAt, endsAt);
+    if (input.roomId !== undefined) {
+      await assertRoomExists(roomId);
+    }
+    // Only an active booking occupies its interval, so only an active booking
+    // can be moved into a conflict.
+    if (booking.status === BOOKING_ACTIVE) {
+      const conflict = await repository.findOverlapping(roomId, startsAt, endsAt, id);
+      if (conflict) {
+        throw await conflictFor(conflict, roomId, startsAt, endsAt);
+      }
+    }
+  }
+
   return repository.update(id, {
     ...(input.roomId !== undefined ? { roomId: input.roomId } : {}),
     ...(input.userId !== undefined ? { userId: input.userId } : {}),
     ...(input.title !== undefined ? { title: input.title } : {}),
-    ...(input.startsAt !== undefined ? { startsAt: parseInstant(input.startsAt) } : {}),
-    ...(input.endsAt !== undefined ? { endsAt: parseInstant(input.endsAt) } : {}),
+    ...(input.startsAt !== undefined ? { startsAt } : {}),
+    ...(input.endsAt !== undefined ? { endsAt } : {}),
   });
 }
 
