+export async function listAvailability(query: AvailabilityInput): Promise<Availability> {
+  const requestedFrom = parseInstant(query.from);
+  const to = parseInstant(query.to);
+  if (!isBefore(requestedFrom, to)) {
+    throw validationFailed('Availability window must end after it starts');
+  }
+  if (durationMinutes(requestedFrom, to) > MAX_WINDOW_MINUTES) {
+    throw validationFailed('Availability window is too long', {
+      maxWindowMinutes: MAX_WINDOW_MINUTES,
+    });
+  }
+  await assertRoomExists(query.roomId);
+
+  // A booking can never start in the past, so a window that reaches back is
+  // searched from now on.
+  const from = earliest(latest(requestedFrom, new Date()), to);
+  const minMinutes = query.durationMinutes ?? MIN_DURATION_MINUTES;
+  const bookings = await repository.listActiveBetween(query.roomId, from, to);
+
+  return { roomId: query.roomId, from, to, slots: freeSlots(bookings, from, to, minMinutes) };
+}
