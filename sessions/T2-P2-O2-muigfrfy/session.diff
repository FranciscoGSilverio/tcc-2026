+
+// Sweeps the active bookings of a room in chronological order and returns the
+// gaps left between them. The interval of a booking includes its start and
+// excludes its end, so a gap may begin at the exact instant a booking ends.
+function freeSlots(bookings: Booking[], from: Date, to: Date, minMinutes: number): Slot[] {
+  const slots: Slot[] = [];
+  let cursor = from;
+
+  for (const booking of bookings) {
+    if (isBefore(cursor, booking.startsAt)) {
+      const slotEnd = earliest(booking.startsAt, to);
+      if (durationMinutes(cursor, slotEnd) >= minMinutes) {
+        slots.push({ startsAt: cursor, endsAt: slotEnd });
+      }
+    }
+    cursor = latest(cursor, booking.endsAt);
+    if (!isBefore(cursor, to)) {
+      return slots;
+    }
+  }
+
+  if (durationMinutes(cursor, to) >= minMinutes) {
+    slots.push({ startsAt: cursor, endsAt: to });
+  }
+  return slots;
+}
+
+async function nextAvailableStart(
+  roomId: string,
+  startsAt: Date,
+  endsAt: Date,
+): Promise<Date | undefined> {
+  const horizon = addMinutes(startsAt, SUGGESTION_WINDOW_MINUTES);
+  const bookings = await repository.listActiveBetween(roomId, startsAt, horizon);
+  const [slot] = freeSlots(bookings, startsAt, horizon, durationMinutes(startsAt, endsAt));
+  return slot?.startsAt;
+}
+
+async function conflictFor(
+  conflict: Booking,
