+function earliest(a: Date, b: Date): Date {
+  return isBefore(a, b) ? a : b;
+}
+
+function latest(a: Date, b: Date): Date {
+  return isBefore(a, b) ? b : a;
+}
+
+function addMinutes(instant: Date, minutes: number): Date {
+  return new Date(instant.getTime() + minutes * MINUTE_IN_MS);
+}
+
+function assertWindow(startsAt: Date, endsAt: Date): void {
+  if (!isBefore(startsAt, endsAt)) {
+    throw validationFailed('Booking must end after it starts');
+  }
+  if (isBefore(startsAt, new Date())) {
+    throw validationFailed('Booking cannot start in the past', { startsAt });
