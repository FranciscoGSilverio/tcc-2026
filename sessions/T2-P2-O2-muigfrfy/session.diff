+  startsAt: Date,
+  endsAt: Date,
+): Promise<AppError> {
+  const suggestion = await nextAvailableStart(roomId, startsAt, endsAt);
+  return bookingConflict(conflict.id, suggestion ? { nextAvailableStart: suggestion } : {});
+}
 
