+export async function getAvailability(query: AvailabilityInput): Promise<AvailabilityResult> {
+  const from = parseInstant(query.from);
+  const to = parseInstant(query.to);
+  if (!isBefore(from, to)) {
+    throw validationFailed('to must be after from', { from: query.from, to: query.to });
+  }
+
+  await getRoom(query.roomId);
+
+  const bookings = await repository.listActiveBetween(query.roomId, from, to);
+
+  const busy = bookings.map((booking) => ({
+    bookingId: booking.id,
+    startsAt: booking.startsAt,
+    endsAt: booking.endsAt,
+  }));
+
+  const free: { startsAt: Date; endsAt: Date }[] = [];
+  const toMs = to.getTime();
+  let cursor = from.getTime();
+
+  for (const booking of bookings) {
+    const startMs = Math.max(booking.startsAt.getTime(), from.getTime());
+    const endMs = Math.min(booking.endsAt.getTime(), toMs);
+    if (cursor < startMs) {
+      free.push({ startsAt: new Date(cursor), endsAt: new Date(startMs) });
+    }
+    cursor = Math.max(cursor, endMs);
+  }
+  if (cursor < toMs) {
+    free.push({ startsAt: new Date(cursor), endsAt: new Date(toMs) });
+  }
+
+  return { roomId: query.roomId, busy, free };
+}
