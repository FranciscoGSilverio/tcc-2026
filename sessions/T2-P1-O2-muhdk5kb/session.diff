   });
+
+  it('rejects a booking that starts before and ends inside an active booking', async () => {
+    await book(24, 25);
+    const response = await book(23.5, 24.5, 'Straddling');
+    expect(response.statusCode).toBe(409);
+    expect(response.json().error.code).toBe('BOOKING_CONFLICT');
+  });
+
+  it('rejects a booking that fully contains an active booking', async () => {
+    await book(24, 25);
+    const response = await book(23.5, 25.5, 'Engulfing');
+    expect(response.statusCode).toBe(409);
+  });
+
+  it('rejects updating a booking into a slot occupied by another active booking', async () => {
+    await book(24, 25);
+    const second = await book(30, 31, 'Retro');
+    const response = await app.inject({
