+
+export async function getAvailability(query: AvailabilityInput): Promise<AvailabilitySlotData[]> {
+  const from = parseInstant(query.from);
+  const to = parseInstant(query.to);
+  if (!isBefore(from, to)) {
+    throw validationFailed('"from" must be before "to"', { from: query.from, to: query.to });
+  }
+  await getRoom(query.roomId);
+
+  const durationMs = (query.duration ?? MIN_BOOKING_DURATION_MINUTES) * MINUTE_IN_MS;
+  const bookings = await repository.findActiveInWindow(query.roomId, from, to);
+
+  const slots: AvailabilitySlotData[] = [];
+  let cursor = from;
+  for (const booking of bookings) {
+    const gapEnd = isBefore(booking.startsAt, to) ? booking.startsAt : to;
+    if (gapEnd.getTime() - cursor.getTime() >= durationMs) {
+      slots.push({ startsAt: cursor, endsAt: gapEnd });
+    }
+    if (isBefore(cursor, booking.endsAt)) {
+      cursor = booking.endsAt;
+    }
+  }
+  if (isBefore(cursor, to) && to.getTime() - cursor.getTime() >= durationMs) {
+    slots.push({ startsAt: cursor, endsAt: to });
+  }
+
+  return slots;
+}
