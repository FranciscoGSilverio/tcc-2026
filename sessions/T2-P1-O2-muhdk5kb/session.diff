+        to: inHours(to),
+        ...(duration !== undefined ? { duration: String(duration) } : {}),
+      });
+      return app.inject({ method: 'GET', url: `/bookings/availability?${query.toString()}` });
+    }
+
+    it('returns the whole window as free when there are no bookings', async () => {
+      const response = await availability(0, 10);
+      expect(response.statusCode).toBe(200);
+      expect(response.json().slots).toHaveLength(1);
+    });
+
+    it('excludes the booked interval from the free slots', async () => {
