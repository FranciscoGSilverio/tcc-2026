+
+  it('provides details of the conflicting booking and suggests available slots', async () => {
+    const first = await book(24, 25);
+    const response = await book(24.5, 25.5, 'Overlap');
+    const details = response.json().error.details;
+
+    expect(details.conflictingBooking).toBeDefined();
+    expect(details.conflictingBooking.id).toBe(first.json().id);
+    expect(details.conflictingBooking.title).toBe('Sync');
+    expect(details.conflictingBooking.startsAt).toBeDefined();
+    expect(details.conflictingBooking.endsAt).toBeDefined();
+
+    expect(details.suggestedSlots).toBeDefined();
+    expect(Array.isArray(details.suggestedSlots)).toBe(true);
+    expect(details.suggestedSlots.length).toBeGreaterThan(0);
+    expect(details.suggestedSlots[0].startsAt).toBeDefined();
+    expect(details.suggestedSlots[0].endsAt).toBeDefined();
+  });
+
+  it('allows booking a suggested slot from conflict response', async () => {
+    await book(24, 25);
+    await book(26, 27);
+    const conflictResponse = await book(24.5, 25.5, 'Overlap');
+
+    const suggestedSlot = conflictResponse.json().error.details.suggestedSlots[0];
+    expect(suggestedSlot).toBeDefined();
+
+    const successResponse = await app.inject({
+      method: 'POST',
+      url: '/bookings',
+      payload: {
+        roomId,
+        userId,
+        title: 'Rebooked',
+        startsAt: suggestedSlot.startsAt,
+        endsAt: suggestedSlot.endsAt,
+      },
+    });
+
+    expect(successResponse.statusCode).toBe(201);
