--- a/src/modules/bookings/repository.ts
+++ b/src/modules/bookings/repository.ts
@@ -69,3 +69,39 @@ export function updateStatus(id: string, status: string): Promise<Booking> {
 export function remove(id: string): Promise<Booking> {
   return prisma.booking.delete({ where: { id } });
 }
+
+export async function findAvailableSlots(
+  roomId: string,
+  startTime: Date,
+  slotDuration: number,
+  count: number = 5,
+): Promise<Array<{ startsAt: Date; endsAt: Date }>> {
+  const searchWindow = new Date(startTime.getTime() + slotDuration * count * 2);
+  const bookings = await prisma.booking.findMany({
+    where: {
+      roomId,
+      status: BOOKING_ACTIVE,
+      startsAt: { lt: searchWindow },
+      endsAt: { gt: startTime },
+    },
+    orderBy: { startsAt: 'asc' },
+  });
+
+  const slots: Array<{ startsAt: Date; endsAt: Date }> = [];
+  let currentStart = new Date(startTime);
+
+  while (slots.length < count) {
+    const currentEnd = new Date(currentStart.getTime() + slotDuration);
+    const hasConflict = bookings.some(
+      (b) => b.startsAt <= currentStart && b.endsAt > currentStart,
+    );
+
+    if (!hasConflict) {
+      slots.push({ startsAt: new Date(currentStart), endsAt: new Date(currentEnd) });
+    }
+
+    currentStart = new Date(currentStart.getTime() + slotDuration);
+  }
+
+  return slots;
+}
