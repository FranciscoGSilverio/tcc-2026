+// A request spends some time in flight, so a start that is a hair behind the
+// clock is still a request for "now" and not a request for the past.
+const PAST_TOLERANCE_MS = MINUTE_IN_MS;
+
+interface Period {
+  startsAt: Date;
+  endsAt: Date;
+}
+
+function assertEndsAfterStart(period: Period): void {
+  if (!isBefore(period.startsAt, period.endsAt)) {
+    throw validationFailed('Booking must end after it starts', {
+      startsAt: period.startsAt.toISOString(),
+      endsAt: period.endsAt.toISOString(),
+    });
+  }
+}
+
+function assertNotInThePast(startsAt: Date): void {
+  if (startsAt.getTime() < Date.now() - PAST_TOLERANCE_MS) {
+    throw validationFailed('Booking cannot start in the past', {
+      startsAt: startsAt.toISOString(),
+    });
+  }
+}
