 export async function updateBooking(id: string, input: UpdateBookingInput): Promise<Booking> {
-  await getBooking(id);
-  return repository.update(id, {
+  const current = await getBooking(id);
+
+  // A patch is validated against the booking it produces, not against the
+  // fields it happens to carry.
+  const startsAt = input.startsAt !== undefined ? parseInstant(input.startsAt) : current.startsAt;
+  const endsAt = input.endsAt !== undefined ? parseInstant(input.endsAt) : current.endsAt;
+  const roomId = input.roomId ?? current.roomId;
+  const movedInTime = input.startsAt !== undefined || input.endsAt !== undefined;
+
+  if (movedInTime) {
+    assertEndsAfterStart({ startsAt, endsAt });
+  }
+  if (input.startsAt !== undefined) {
+    // Only a start that is being set has to be in the future: a booking that
+    // already happened can still be renamed or have its end corrected.
+    assertNotInThePast(startsAt);
+  }
+  if (input.roomId !== undefined) {
+    await assertRoomExists(roomId);
+  }
+  if (input.userId !== undefined) {
+    await assertUserExists(input.userId);
+  }
+
+  const data = {
     ...(input.roomId !== undefined ? { roomId: input.roomId } : {}),
     ...(input.userId !== undefined ? { userId: input.userId } : {}),
     ...(input.title !== undefined ? { title: input.title } : {}),
-    ...(input.startsAt !== undefined ? { startsAt: parseInstant(input.startsAt) } : {}),
-    ...(input.endsAt !== undefined ? { endsAt: parseInstant(input.endsAt) } : {}),
+    ...(input.startsAt !== undefined ? { startsAt } : {}),
+    ...(input.endsAt !== undefined ? { endsAt } : {}),
+  };
+
+  // A cancelled booking holds no slot, so it can only clash once it is active.
+  const needsSlot = current.status === BOOKING_ACTIVE && (movedInTime || input.roomId !== undefined);
+
+  return repository.transaction(async (tx) => {
+    if (needsSlot) {
+      const conflict = await repository.findOverlapping(
+        { roomId, startsAt, endsAt, excludeBookingId: id },
+        tx,
+      );
+      if (conflict) {
+        throw bookingConflict(conflict.id);
+      }
+    }
+    return repository.update(id, data, tx);
   });
 }
 
