+export interface OverlapQuery {
+  roomId: string;
+  startsAt: Date;
+  endsAt: Date;
+  excludeBookingId?: string;
+}
+
+// The plain client and the client handed out by an interactive transaction share
+// this shape, so every query below can run inside or outside a transaction.
+export type Db = Prisma.TransactionClient;
+
+// Reading the room's agenda and writing to it has to happen as a single unit,
+// otherwise two requests can both find the slot free before either one writes.
+export function transaction<T>(run: (tx: Db) => Promise<T>): Promise<T> {
+  return prisma.$transaction(run);
+}
+
+export function create(data: BookingData, db: Db = prisma): Promise<Booking> {
+  return db.booking.create({ data });
 }
 
