+export function findOverlapping(query: OverlapQuery, db: Db = prisma): Promise<Booking | null> {
+  return db.booking.findFirst({
     where: {
-      roomId,
+      roomId: query.roomId,
       status: BOOKING_ACTIVE,
-      startsAt: { lte: startsAt },
-      endsAt: { gt: startsAt },
+      // Two periods overlap when each one starts strictly before the other ends.
+      // Touching periods (one starts exactly when the other ends) do not overlap.
+      startsAt: { lt: query.endsAt },
+      endsAt: { gt: query.startsAt },
+      ...(query.excludeBookingId ? { id: { not: query.excludeBookingId } } : {}),
     },
+    orderBy: { startsAt: 'asc' },
   });
 }
 
