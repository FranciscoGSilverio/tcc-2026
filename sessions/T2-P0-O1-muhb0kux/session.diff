+  to: Type.String({ minLength: 1 }),
+  durationMinutes: Type.Optional(Type.Integer({ minimum: 1 })),
+};
+
+export const RoomAvailabilityQuery = Type.Object(windowFields);
+
+export const SearchAvailabilityQuery = Type.Object({
+  ...windowFields,
+  capacity: Type.Optional(Type.Integer({ minimum: 1 })),
+  limit: Type.Optional(Type.Integer({ minimum: 1 })),
+  offset: Type.Optional(Type.Integer({ minimum: 0 })),
+});
+
+export const RoomAvailabilityParams = Type.Object({ id: Type.String({ minLength: 1 }) });
+
+export const RoomAvailabilityResponse = Type.Object({
+  roomId: Type.String(),
+  roomName: Type.String(),
+  capacity: Type.Integer(),
+  from: DateString,
+  to: DateString,
+  slots: Type.Array(SlotResponse),
+});
+
+export const AvailabilityPage = Type.Object({
+  data: Type.Array(RoomAvailabilityResponse),
+  pagination: Type.Object({
+    total: Type.Integer(),
+    limit: Type.Integer(),
+    offset: Type.Integer(),
+  }),
+});
+
+export type RoomAvailabilityInput = Static<typeof RoomAvailabilityQuery>;
+export type SearchAvailabilityInput = Static<typeof SearchAvailabilityQuery>;
