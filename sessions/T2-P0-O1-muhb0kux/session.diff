+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'vitest';
+import type { FastifyInstance } from 'fastify';
+import { createTestApp, resetDb } from './helpers/app.js';
+
+/** Fixed instants keep the expectations readable and independent of the clock. */
+function at(hour: number): string {
+  return new Date(Date.UTC(2030, 0, 1, hour)).toISOString();
+}
+
+describe('availability', () => {
+  let app: FastifyInstance;
+  let roomId: string;
+  let boothId: string;
+  let userId: string;
+
+  beforeAll(async () => {
+    app = await createTestApp();
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  beforeEach(async () => {
+    await resetDb();
+    roomId = (
+      await app.inject({ method: 'POST', url: '/rooms', payload: { name: 'Aurora', capacity: 6 } })
+    ).json().id;
+    boothId = (
+      await app.inject({ method: 'POST', url: '/rooms', payload: { name: 'Booth', capacity: 2 } })
+    ).json().id;
+    userId = (
+      await app.inject({
+        method: 'POST',
+        url: '/users',
+        payload: { name: 'Ada Lovelace', email: 'ada@example.com' },
+      })
+    ).json().id;
+  });
+
+  async function book(startHour: number, endHour: number, title = 'Sync', room = roomId) {
+    return app.inject({
+      method: 'POST',
+      url: '/bookings',
+      payload: { roomId: room, userId, title, startsAt: at(startHour), endsAt: at(endHour) },
+    });
+  }
+
+  function availability(room: string, query = ''): Promise<ReturnType<typeof app.inject>> {
+    return app.inject({
+      method: 'GET',
