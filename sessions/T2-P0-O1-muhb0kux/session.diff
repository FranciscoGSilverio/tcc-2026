@@ -0,0 +1,94 @@
+import type { Room } from '@prisma/client';
+import { notFound, validationFailed } from '../../shared/errors.js';
+import { freeSlots, type Interval } from '../../shared/intervals.js';
+import { normalizeLimit, normalizeOffset, paginated, type Page } from '../../shared/pagination.js';
+import { assertOrderedRange, DAY_IN_MS, MINUTE_IN_MS, parseInstant } from '../../shared/time.js';
+import * as bookingsRepository from '../bookings/repository.js';
+import * as roomsRepository from '../rooms/repository.js';
+import type { RoomAvailabilityInput, SearchAvailabilityInput } from './schema.js';
+
+/** Keeps a single request from scanning an unbounded stretch of the calendar. */
+export const MAX_WINDOW_DAYS = 31;
+
+export interface RoomAvailability {
+  roomId: string;
+  roomName: string;
+  capacity: number;
+  from: Date;
+  to: Date;
+  slots: Interval[];
+}
+
+export async function getRoomAvailability(
+  roomId: string,
+  query: RoomAvailabilityInput,
+): Promise<RoomAvailability> {
+  const room = await roomsRepository.findById(roomId);
+  if (!room) {
+    throw notFound('Room');
+  }
+
+  const window = parseWindow(query.from, query.to);
+  const busy = await bookingsRepository.findBusyIntervals([room.id], window);
+  return describe(room, window, busy.get(room.id) ?? [], minimumMs(query.durationMinutes));
+}
+
+export async function searchAvailability(
+  query: SearchAvailabilityInput,
+): Promise<Page<RoomAvailability>> {
+  const window = parseWindow(query.from, query.to);
+  const limit = normalizeLimit(query.limit);
+  const offset = normalizeOffset(query.offset);
+
+  const [rooms, total] = await roomsRepository.list({
+    minCapacity: query.capacity,
+    limit,
+    offset,
+  });
+
+  const busy = await bookingsRepository.findBusyIntervals(
+    rooms.map((room) => room.id),
+    window,
+  );
+  const minimum = minimumMs(query.durationMinutes);
+  const data = rooms.map((room) => describe(room, window, busy.get(room.id) ?? [], minimum));
+
+  return paginated(data, total, limit, offset);
+}
+
+function describe(
+  room: Room,
+  window: Interval,
+  busy: Interval[],
+  minimum: number,
+): RoomAvailability {
+  return {
+    roomId: room.id,
+    roomName: room.name,
+    capacity: room.capacity,
+    from: window.startsAt,
+    to: window.endsAt,
+    slots: freeSlots(window, busy, minimum),
+  };
+}
+
+function minimumMs(durationMinutes?: number): number {
+  return durationMinutes === undefined ? 1 : durationMinutes * MINUTE_IN_MS;
+}
+
+function parseWindow(from: string, to: string): Interval {
+  const startsAt = parseInstant(from);
+  const endsAt = parseInstant(to);
+  assertOrderedRange(startsAt, endsAt, { start: 'from', end: 'to' });
+
+  if (endsAt.getTime() - startsAt.getTime() > MAX_WINDOW_DAYS * DAY_IN_MS) {
+    throw validationFailed(
+      `The availability window cannot be longer than ${MAX_WINDOW_DAYS} days`,
+      {
+        maxWindowDays: MAX_WINDOW_DAYS,
+      },
+    );
+  }
+
+  return { startsAt, endsAt };
+}
