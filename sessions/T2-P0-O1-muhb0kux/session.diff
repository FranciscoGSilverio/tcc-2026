index 0000000..cc02175
--- /dev/null
+++ b/src/shared/intervals.ts
@@ -0,0 +1,64 @@
+export interface Interval {
+  startsAt: Date;
+  endsAt: Date;
+}
+
+/**
+ * Merges overlapping and touching intervals into a minimal ordered set.
+ *
+ * Touching intervals are merged on purpose: [09:00, 10:00) and [10:00, 11:00)
+ * leave no usable gap between them, so busy time is reported as [09:00, 11:00).
+ */
+export function mergeIntervals(intervals: Interval[]): Interval[] {
+  const sorted = [...intervals].sort((a, b) => a.startsAt.getTime() - b.startsAt.getTime());
+  const merged: Interval[] = [];
+
+  for (const current of sorted) {
+    if (current.endsAt.getTime() <= current.startsAt.getTime()) continue;
+
+    const last = merged.at(-1);
+    if (last && current.startsAt.getTime() <= last.endsAt.getTime()) {
+      if (current.endsAt.getTime() > last.endsAt.getTime()) {
+        merged[merged.length - 1] = { startsAt: last.startsAt, endsAt: current.endsAt };
+      }
+      continue;
+    }
+    merged.push({ startsAt: current.startsAt, endsAt: current.endsAt });
+  }
+
+  return merged;
+}
+
+/**
+ * Returns the parts of `window` that `busy` leaves uncovered, keeping only the
+ * gaps that last at least `minimumMs`. Busy intervals may overlap each other and
+ * may extend beyond the window; they are clipped and merged first.
+ */
+export function freeSlots(window: Interval, busy: Interval[], minimumMs = 1): Interval[] {
+  const windowStart = window.startsAt.getTime();
+  const windowEnd = window.endsAt.getTime();
+  if (windowEnd <= windowStart) return [];
+
+  const clipped = busy
+    .map((interval) => ({
+      startsAt: new Date(Math.max(interval.startsAt.getTime(), windowStart)),
+      endsAt: new Date(Math.min(interval.endsAt.getTime(), windowEnd)),
+    }))
+    .filter((interval) => interval.endsAt.getTime() > interval.startsAt.getTime());
+
+  const slots: Interval[] = [];
+  let cursor = windowStart;
+
+  for (const interval of mergeIntervals(clipped)) {
+    if (interval.startsAt.getTime() - cursor >= minimumMs) {
+      slots.push({ startsAt: new Date(cursor), endsAt: new Date(interval.startsAt.getTime()) });
+    }
+    cursor = Math.max(cursor, interval.endsAt.getTime());
+  }
+
+  if (windowEnd - cursor >= minimumMs) {
+    slots.push({ startsAt: new Date(cursor), endsAt: new Date(windowEnd) });
+  }
+
+  return slots;
+}
