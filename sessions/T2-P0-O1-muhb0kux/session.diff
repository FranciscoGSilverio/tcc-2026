+    const response = await availability(roomId, '&durationMinutes=120');
+    expect(response.json().slots).toEqual([
+      { startsAt: at(10), endsAt: at(14) },
+      { startsAt: at(15), endsAt: at(18) },
+    ]);
+  });
+
+  it('frees the slot of a cancelled booking', async () => {
+    const created = await book(9, 10, 'Standup');
+    await app.inject({ method: 'POST', url: `/bookings/${created.json().id}/cancel` });
+    const response = await availability(roomId);
+    expect(response.json().slots).toEqual([{ startsAt: at(8), endsAt: at(18) }]);
+  });
+
+  it('reports a fully booked room as having no slots', async () => {
+    await book(8, 18, 'All day');
+    const response = await availability(roomId);
+    expect(response.json().slots).toEqual([]);
+  });
+
+  it('answers 404 for a room that does not exist', async () => {
+    const response = await availability('missing');
+    expect(response.statusCode).toBe(404);
+    expect(response.json().error.code).toBe('NOT_FOUND');
+  });
+
+  it('rejects a window that ends before it starts', async () => {
+    const response = await app.inject({
+      method: 'GET',
+      url: `/rooms/${roomId}/availability?from=${at(18)}&to=${at(8)}`,
+    });
+    expect(response.statusCode).toBe(400);
+    expect(response.json().error.code).toBe('VALIDATION_ERROR');
+  });
+
+  it('rejects a window longer than the supported maximum', async () => {
+    const response = await app.inject({
+      method: 'GET',
+      url: `/rooms/${roomId}/availability?from=${at(8)}&to=${new Date(
+        Date.UTC(2030, 3, 1),
+      ).toISOString()}`,
+    });
+    expect(response.statusCode).toBe(400);
+    expect(response.json().error.details.maxWindowDays).toBe(31);
+  });
+
+  it('requires the window bounds', async () => {
+    const response = await app.inject({ method: 'GET', url: `/rooms/${roomId}/availability` });
+    expect(response.statusCode).toBe(400);
+  });
+
+  describe('across rooms', () => {
+    it('reports every room inside the page envelope', async () => {
+      await book(9, 10, 'Standup');
+      const response = await app.inject({
+        method: 'GET',
+        url: `/availability?from=${at(8)}&to=${at(18)}`,
+      });
+      expect(response.statusCode).toBe(200);
+      expect(response.json().pagination.total).toBe(2);
+      const byName = Object.fromEntries(
+        response
+          .json()
+          .data.map((entry: { roomName: string; slots: unknown }) => [entry.roomName, entry.slots]),
+      );
+      expect(byName.Aurora).toEqual([
+        { startsAt: at(8), endsAt: at(9) },
+        { startsAt: at(10), endsAt: at(18) },
+      ]);
+      expect(byName.Booth).toEqual([{ startsAt: at(8), endsAt: at(18) }]);
+    });
+
+    it('keeps only the rooms that are big enough', async () => {
+      const response = await app.inject({
+        method: 'GET',
+        url: `/availability?from=${at(8)}&to=${at(18)}&capacity=4`,
+      });
+      expect(response.json().data).toHaveLength(1);
+      expect(response.json().data[0].roomId).toBe(roomId);
+    });
+
+    it('does not let one room hide the bookings of another', async () => {
+      await book(9, 17, 'Aurora only');
+      const response = await app.inject({
+        method: 'GET',
+        url: `/availability?from=${at(8)}&to=${at(18)}&durationMinutes=240`,
+      });
+      const booth = response
+        .json()
+        .data.find((entry: { roomId: string }) => entry.roomId === boothId);
+      expect(booth.slots).toEqual([{ startsAt: at(8), endsAt: at(18) }]);
+    });
+  });
+});
