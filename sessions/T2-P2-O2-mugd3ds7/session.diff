   });
+
+  it('rejects a booking that starts before and ends inside an active booking', async () => {
+    await book(24, 25);
+    const response = await book(23.5, 24.5, 'Straddles start');
+    expect(response.statusCode).toBe(409);
+    expect(response.json().error.code).toBe('BOOKING_CONFLICT');
+  });
+
+  it('rejects updating a booking into a time that overlaps another active booking', async () => {
+    await book(24, 25);
+    const second = await book(26, 27, 'Movable');
+    const response = await app.inject({
+      method: 'PATCH',
+      url: `/bookings/${second.json().id}`,
+      payload: { startsAt: inHours(24.5), endsAt: inHours(25.5) },
+    });
+    expect(response.statusCode).toBe(409);
+    expect(response.json().error.code).toBe('BOOKING_CONFLICT');
+  });
+
+  it('allows updating a booking to a time that does not overlap any other booking', async () => {
+    const created = await book(24, 25);
+    const response = await app.inject({
+      method: 'PATCH',
+      url: `/bookings/${created.json().id}`,
+      payload: { startsAt: inHours(30), endsAt: inHours(31) },
+    });
+    expect(response.statusCode).toBe(200);
+  });
+
+  describe('available slots', () => {
+    // All offsets in this block are computed from a single fixed `base` per test so that
+    // exact-boundary comparisons (e.g. a gap of precisely 60 minutes) aren't flaky due to
+    // drift between successive Date.now() calls.
+    function isoAt(base: number, hours: number): string {
+      return new Date(base + hours * HOUR).toISOString();
+    }
+
+    async function bookAt(base: number, startHours: number, endHours: number, title = 'Sync') {
+      return app.inject({
+        method: 'POST',
+        url: '/bookings',
+        payload: {
+          roomId,
+          userId,
+          title,
+          startsAt: isoAt(base, startHours),
+          endsAt: isoAt(base, endHours),
+        },
+      });
+    }
+
+    async function availableSlotsAt(base: number, fromHours: number, toHours: number, duration: number) {
+      return app.inject({
+        method: 'GET',
+        url:
+          `/bookings/available-slots?roomId=${roomId}` +
+          `&from=${isoAt(base, fromHours)}&to=${isoAt(base, toHours)}&duration=${duration}`,
+      });
+    }
+
+    it('returns the whole window as one slot when there are no bookings', async () => {
+      const base = Date.now();
+      const response = await availableSlotsAt(base, 24, 28, 60);
+      expect(response.statusCode).toBe(200);
+      expect(response.json().data).toEqual([
+        { startsAt: isoAt(base, 24), endsAt: isoAt(base, 28) },
+      ]);
+    });
+
+    it('splits the window around an existing booking', async () => {
+      const base = Date.now();
+      await bookAt(base, 25, 26);
+      const response = await availableSlotsAt(base, 24, 28, 60);
+      expect(response.json().data).toEqual([
+        { startsAt: isoAt(base, 24), endsAt: isoAt(base, 25) },
+        { startsAt: isoAt(base, 26), endsAt: isoAt(base, 28) },
+      ]);
+    });
+
+    it('returns no slots when a booking covers the whole window', async () => {
+      const base = Date.now();
+      await bookAt(base, 24, 28);
+      const response = await availableSlotsAt(base, 24, 28, 30);
+      expect(response.json().data).toHaveLength(0);
+    });
+
+    it('excludes gaps shorter than the requested duration', async () => {
+      const base = Date.now();
+      await bookAt(base, 24.5, 25);
+      await bookAt(base, 25.25, 26, 'Second');
+      const response = await availableSlotsAt(base, 24, 28, 60);
+      const gapStarts = response.json().data.map((slot: { startsAt: string }) => slot.startsAt);
+      expect(gapStarts).not.toContain(isoAt(base, 25));
+    });
+
+    it('answers 404 when the room does not exist', async () => {
+      const base = Date.now();
+      const response = await app.inject({
+        method: 'GET',
+        url:
+          `/bookings/available-slots?roomId=missing` +
+          `&from=${isoAt(base, 24)}&to=${isoAt(base, 28)}&duration=30`,
+      });
+      expect(response.statusCode).toBe(404);
+    });
+
+    it('rejects a window where "from" is not before "to"', async () => {
+      const base = Date.now();
+      const response = await availableSlotsAt(base, 28, 24, 30);
+      expect(response.statusCode).toBe(400);
+      expect(response.json().error.code).toBe('VALIDATION_ERROR');
+    });
+
+    it('rejects a duration outside the bookable range', async () => {
+      const base = Date.now();
+      const tooShort = await availableSlotsAt(base, 24, 28, 10);
+      expect(tooShort.statusCode).toBe(400);
+      const tooLong = await availableSlotsAt(base, 24, 28, 600);
+      expect(tooLong.statusCode).toBe(400);
+    });
+  });
 });
