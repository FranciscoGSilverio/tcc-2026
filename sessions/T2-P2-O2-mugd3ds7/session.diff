+
+export async function listAvailableSlots(query: AvailableSlotsInput): Promise<{ data: AvailableSlot[] }> {
+  const room = await repository.findRoomById(query.roomId);
+  if (!room) {
+    throw notFound('Room');
+  }
+
+  const from = parseInstant(query.from);
+  const to = parseInstant(query.to);
+  if (!isBefore(from, to)) {
+    throw validationFailed('"from" must be before "to"');
+  }
+
+  if (query.duration < MIN_DURATION_MINUTES || query.duration > MAX_DURATION_MINUTES) {
+    throw validationFailed(
+      `Duration must be between ${MIN_DURATION_MINUTES} and ${MAX_DURATION_MINUTES} minutes`,
+      { minMinutes: MIN_DURATION_MINUTES, maxMinutes: MAX_DURATION_MINUTES },
+    );
+  }
+
+  const durationMs = query.duration * MINUTE_IN_MS;
+  const bookings = await repository.listActiveOverlapping(query.roomId, from, to);
+
+  const slots: AvailableSlot[] = [];
+  let cursor = from;
+  for (const booking of bookings) {
+    if (booking.startsAt.getTime() - cursor.getTime() >= durationMs) {
+      slots.push({ startsAt: cursor, endsAt: booking.startsAt });
+    }
+    if (booking.endsAt.getTime() > cursor.getTime()) {
+      cursor = booking.endsAt;
+    }
+  }
+  if (to.getTime() - cursor.getTime() >= durationMs) {
+    slots.push({ startsAt: cursor, endsAt: to });
+  }
+
+  return { data: slots };
+}
