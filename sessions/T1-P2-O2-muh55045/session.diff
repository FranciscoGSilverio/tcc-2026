+async function validateBookingRules(
+  startsAt: Date,
+  endsAt: Date,
+  roomId: string,
+  userId: string,
+): Promise<void> {
+  if (isBefore(startsAt, new Date())) {
+    throw validationFailed('Booking start must be in the future');
+  }
+
+  if (!isBefore(startsAt, endsAt)) {
+    throw validationFailed('Booking end must be after start');
+  }
+
+  const duration = durationMinutes(startsAt, endsAt);
+  if (duration < MIN_DURATION_MINUTES || duration > MAX_DURATION_MINUTES) {
+    throw validationFailed(
+      `Booking duration must be between ${MIN_DURATION_MINUTES} minutes and ${Math.floor(MAX_DURATION_MINUTES / 60)} hours`,
+      { duration, min: MIN_DURATION_MINUTES, max: MAX_DURATION_MINUTES },
+    );
+  }
+
+  const room = await roomRepository.findById(roomId);
+  if (!room) {
+    throw notFound('Room');
+  }
+
+  const user = await userRepository.findById(userId);
+  if (!user) {
+    throw notFound('User');
+  }
+}
