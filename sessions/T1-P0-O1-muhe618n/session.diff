diff --git a/tests/conflict-test.test.ts b/tests/conflict-test.test.ts
new file mode 100644
index 0000000..589092a
--- /dev/null
+++ b/tests/conflict-test.test.ts
@@ -0,0 +1,110 @@
+import { describe, it, expect, beforeAll, afterAll, beforeEach } from 'vitest';
+import type { FastifyInstance } from 'fastify';
+import { createTestApp, resetDb } from './helpers/app.js';
+
+const HOUR = 3_600_000;
+
+function inHours(hours: number): string {
+  return new Date(Date.now() + hours * HOUR).toISOString();
+}
+
+describe('booking conflicts - edge cases', () => {
+  let app: FastifyInstance;
+  let roomId: string;
+  let userId: string;
+
+  beforeAll(async () => {
+    app = await createTestApp();
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  beforeEach(async () => {
+    await resetDb();
+    const room = await app.inject({
+      method: 'POST',
+      url: '/rooms',
+      payload: { name: 'Aurora', capacity: 6 },
+    });
+    roomId = room.json().id;
+    const user = await app.inject({
+      method: 'POST',
+      url: '/users',
+      payload: { name: 'Ada Lovelace', email: 'ada@example.com' },
+    });
+    userId = user.json().id;
+  });
+
+  async function book(startHours: number, endHours: number, title = 'Sync') {
+    return app.inject({
+      method: 'POST',
+      url: '/bookings',
+      payload: { roomId, userId, title, startsAt: inHours(startHours), endsAt: inHours(endHours) },
+    });
+  }
+
+  it('rejects a booking that starts before and ends inside an active booking', async () => {
+    await book(25, 26);
+    const response = await book(24, 25.5, 'Overlap from before');
+    expect(response.statusCode).toBe(409);
+    expect(response.json().error.code).toBe('BOOKING_CONFLICT');
+  });
+
+  it('rejects a booking that completely contains an active booking', async () => {
+    await book(25, 26);
+    const response = await book(24, 27, 'Contains all');
+    expect(response.statusCode).toBe(409);
+    expect(response.json().error.code).toBe('BOOKING_CONFLICT');
+  });
+
+  it('rejects a booking when end time is before or equal to start time', async () => {
+    const response = await book(25, 25, 'Invalid time');
+    expect(response.statusCode).toBe(400);
+    expect(response.json().error.code).toBe('VALIDATION_ERROR');
+  });
+
+  it('rejects a booking with non-existent room', async () => {
+    const response = await app.inject({
+      method: 'POST',
+      url: '/bookings',
+      payload: { roomId: 'invalid-room', userId, title: 'Test', startsAt: inHours(24), endsAt: inHours(25) },
+    });
+    expect(response.statusCode).toBe(404);
+    expect(response.json().error.code).toBe('NOT_FOUND');
+  });
+
+  it('rejects a booking with non-existent user', async () => {
+    const response = await app.inject({
+      method: 'POST',
+      url: '/bookings',
+      payload: { roomId, userId: 'invalid-user', title: 'Test', startsAt: inHours(24), endsAt: inHours(25) },
+    });
+    expect(response.statusCode).toBe(404);
+    expect(response.json().error.code).toBe('NOT_FOUND');
+  });
+
+  it('rejects a booking update that creates a time conflict', async () => {
+    const first = await book(25, 26);
+    const second = await book(30, 31);
+    const response = await app.inject({
+      method: 'PATCH',
+      url: `/bookings/${second.json().id}`,
+      payload: { startsAt: inHours(25.5), endsAt: inHours(26.5) },
+    });
+    expect(response.statusCode).toBe(409);
+    expect(response.json().error.code).toBe('BOOKING_CONFLICT');
+  });
+
+  it('allows updating a booking if times remain the same', async () => {
+    const booking = await book(25, 26);
+    const response = await app.inject({
+      method: 'PATCH',
+      url: `/bookings/${booking.json().id}`,
+      payload: { title: 'Updated title' },
+    });
+    expect(response.statusCode).toBe(200);
+    expect(response.json().title).toBe('Updated title');
+  });
+});
