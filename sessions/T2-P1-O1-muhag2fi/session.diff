+
+export async function getAvailability(query: AvailabilityInput): Promise<AvailabilityResult> {
+  await getRoom(query.roomId);
+
+  const from = parseInstant(query.from);
+  const to = parseInstant(query.to);
+  if (!isBefore(from, to)) {
+    throw validationFailed('"from" must be before "to"', { from: query.from, to: query.to });
+  }
+
+  const overlapping = await repository.listOverlapping(query.roomId, from, to);
+
+  const slots: AvailabilityResult['slots'] = [];
+  let cursor = from;
+  for (const booking of overlapping) {
+    if (isBefore(cursor, booking.startsAt)) {
+      slots.push({ startsAt: cursor, endsAt: booking.startsAt });
+    }
+    if (isBefore(cursor, booking.endsAt)) {
+      cursor = booking.endsAt;
+    }
+  }
+  if (isBefore(cursor, to)) {
+    slots.push({ startsAt: cursor, endsAt: to });
+  }
+
+  return { roomId: query.roomId, from, to, slots };
+}
