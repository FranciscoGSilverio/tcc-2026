+  async function availability(from: number, to: number, duration?: number) {
+    const params = new URLSearchParams({
+      roomId,
+      from: inHours(from),
+      to: inHours(to),
+    });
+    if (duration !== undefined) params.set('duration', String(duration));
+    return app.inject({ method: 'GET', url: `/bookings/availability?${params.toString()}` });
+  }
+
+  it('returns the full window as available when there are no bookings', async () => {
+    const response = await availability(24, 26);
+    expect(response.statusCode).toBe(200);
+    expect(response.json().data).toHaveLength(1);
+  });
+
+  it('excludes an active booking from the availability window', async () => {
+    const created = await book(24, 25);
+    const response = await availability(24, 26);
+    const slots = response.json().data;
+    expect(slots).toHaveLength(1);
+    expect(slots[0].startsAt).toBe(created.json().endsAt);
+  });
+
+  it('returns free slots before and after a busy interval', async () => {
+    const created = await book(24.5, 25.5);
+    const response = await availability(24, 26);
+    const slots = response.json().data;
+    expect(slots).toHaveLength(2);
+    expect(slots[0].endsAt).toBe(created.json().startsAt);
+    expect(slots[1].startsAt).toBe(created.json().endsAt);
+  });
+
+  it('treats a cancelled booking as available again', async () => {
+    const created = await book(24, 25);
+    await app.inject({ method: 'POST', url: `/bookings/${created.json().id}/cancel` });
