+
+export async function getRoomAvailability(query: AvailabilityInput): Promise<AvailabilitySlotOutput[]> {
+  const room = await roomsRepository.findById(query.roomId);
+  if (!room) {
+    throw notFound('Room');
+  }
+
+  const from = parseInstant(query.from);
+  const to = parseInstant(query.to);
+  if (!isBefore(from, to)) {
+    throw validationFailed('"from" must be before "to"');
+  }
+
+  const busy = await repository.findActiveOverlapping(query.roomId, from, to);
+
+  const slots: AvailabilitySlotOutput[] = [];
+  let cursor = from;
+  for (const booking of busy) {
+    const busyStart = isBefore(booking.startsAt, from) ? from : booking.startsAt;
+    if (isBefore(cursor, busyStart)) {
+      slots.push({ startsAt: cursor, endsAt: busyStart });
+    }
+    if (isBefore(cursor, booking.endsAt)) {
+      cursor = booking.endsAt;
+    }
+  }
+  if (isBefore(cursor, to)) {
+    slots.push({ startsAt: cursor, endsAt: to });
+  }
+
+  const minDuration = query.duration;
+  if (minDuration === undefined) {
+    return slots;
+  }
+  return slots.filter((slot) => durationMinutes(slot.startsAt, slot.endsAt) >= minDuration);
+}
